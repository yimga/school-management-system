# Staging / production deploy profile (copy to Render/host env; do not commit secrets).
# Run: STAGING_PROFILE=1 python scripts/verify_staging_deploy_profile.py

DEBUG=0
SECRET_KEY=replace-with-50+-char-random-secret
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
DATABASE_URL=postgresql://...
ALLOWED_HOSTS=.runmycampus.com,manager.runmycampus.com
OAUTH_CALLBACK_BASE_URL=https://manager.runmycampus.com

# Platform brand assets (static defaults in repo; override for CDN if needed)
PUBLIC_BRAND_LOGO_URL=/static/images/brand/runmycampus-logo-mark.svg
PUBLIC_BRAND_LOGO_DARK_URL=/static/images/brand/runmycampus-logo-mark.svg
PUBLIC_BRAND_FAVICON_URL=/static/images/runmycampus-icon-bell.svg
PUBLIC_BRAND_PRIMARY_COLOR=#002147
PUBLIC_BRAND_ACCENT_COLOR=#d4af37
