# .env.local - Local Development Environment
# Copy this to .env and fill in with your local values
# WARNING: NEVER commit this file with real secrets

DEBUG=1
SECRET_KEY=dev-only-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.local

# Local Database (SQLite by default, or set DATABASE_URL for Postgres)
DATABASE_URL=

# Webhook Configuration (for testing)
WEBHOOK_RATE_LIMIT=1000
WEBHOOK_SIGNATURE_ALGORITHM=sha256
WEBHOOK_SIGNATURE_HEADER=X-Signature
WEBHOOK_IP_WHITELIST=127.0.0.1,localhost

# Local Email (console backend - prints to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Local Caching (in-memory)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Logging
LOG_LEVEL=DEBUG

# Feature Flags
ENABLE_PARENT_PORTAL=True
ENABLE_TEACHER_PORTAL=True
MAINTENANCE_MODE=False
