DEBUG=1
SECRET_KEY=change-me-to-a-very-secure-random-key-min-50-chars
# Comma-separated. On Render, *.onrender.com is added automatically when RENDER=true.
ALLOWED_HOSTS=localhost,127.0.0.1
# Canonical production domain (public root + tenant wildcard).
# MULTI_TENANT_BASE_DOMAIN=runmycampus.com
# Manager host base URL (Studio system config links for super-only tools)
# MANAGER_PLATFORM_BASE_URL=https://manager.runmycampus.com
# Tenant school URL for Approval hub links when browsing Studio on manager host
# STUDIO_APPROVAL_HUB_TENANT_BASE_URL=https://your-school.runmycampus.com
# Temporary legacy redirect support during domain cutover.
# MULTI_TENANT_LEGACY_BASE_DOMAINS=legacy.runmycampus.com
# SESSION_COOKIE_DOMAIN=.runmycampus.com
# CSRF_COOKIE_DOMAIN=.runmycampus.com
# Production HTTPS (e.g. Render): include canonical app domains.
# Example: https://runmycampus.com,https://*.runmycampus.com,https://school-management-system-2kzk.onrender.com
# CSRF_TRUSTED_ORIGINS=

# Database Configuration
# Option A: Full URL (recommended for Render and most platforms)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Render: paste the Internal Database URL from your Postgres service.
DATABASE_URL=

# Option B: Separate vars (used if DATABASE_URL is not set; config builds the URL)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=school_platform_db
# DB_USER=
# DB_PASSWORD=

# SQLite only: use a different file when db.sqlite3 is corrupted or locked (e.g. db_fresh.sqlite3)
# DB_FILE=db_fresh.sqlite3

# --- Security & Credentials (NEVER commit real values!) ---

# Session: for shared computers use 15–30 min inactivity (seconds = minutes × 60)
# Leave empty to use SESSION_COOKIE_AGE (default 4 hours)
# SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# SESSION_COOKIE_AGE=14400
# SESSION_SAVE_EVERY_REQUEST=1
# SESSION_EXPIRE_AT_BROWSER_CLOSE=1

# Webhook Security Configuration
WEBHOOK_RATE_LIMIT=100
# Optional: HMAC secret for POST /api/oneroster/v1p1/roster-webhook (district roster push)
# ONEROSTER_WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_ALGORITHM=sha256
WEBHOOK_SIGNATURE_HEADER=X-Signature
# Comma-separated list of allowed IPs for webhooks (leave empty to allow all)
WEBHOOK_IP_WHITELIST=
OBSERVABILITY_API_KEY=

# Control plane: URL to incident runbooks (health dashboard links here). Required when running control plane.
# CONTROL_PLANE_RUNBOOKS_URL=https://docs.example.com/runbooks

# --- Policy / Marketplace (Phase 7, 24.12) — non-negotiable, default on ---
# Use blueprint bundles in resolver (1 = yes). Required; default 1.
# POLICY_USE_BUNDLES=1
# Per-tenant policy cache TTL in seconds. Required for scale; default 300. Set 0 only to disable for debugging.
# POLICY_CACHE_TTL=300
# Comma-separated Django app labels that third-party marketplace apps may use for schema patches. Empty = none (24.12).
# THIRD_PARTY_SCHEMA_PATCH_ALLOWLIST=

# Payment Provider Integration Secrets
# These should be set via environment variables or Django admin PaymentIntegration model
# MTN MoMo Configuration
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/finance/webhook/mtn_momo/

# Orange Money Configuration
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_CALLBACK_URL=https://yourdomain.com/finance/webhook/orange_money/

# --- LibreOffice Online / Collabora ---
# Public collabora host URL (no trailing slash)
# Example: https://collabora.runmycampus.com
COLLABORA_BASE_URL=
# Shared secret used to sign WOPI access tokens
WOPI_SHARED_SECRET=

# --- Email Configuration (for notifications) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Admin Settings ---
ADMIN_URL_PREFIX=admin

# --- Caching (Redis optional for production) ---
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
REDIS_URL=

# --- Logging ---
LOG_LEVEL=INFO

# --- Region & locale (default: Buea/Cameroon) ---
# For Buea/Cameroon: use REGION_CODE=CMR and TIME_ZONE=Africa/Douala
# For other countries set accordingly (e.g. NGA/Africa/Lagos, USA/America/New_York)
REGION_CODE=CMR
TIME_ZONE=Africa/Douala

# When True, show region switcher and allow switching region in session (multi-region deployments)
ENABLE_MULTI_REGION=False

# --- Feature Flags ---
ENABLE_PARENT_PORTAL=True
ENABLE_TEACHER_PORTAL=True
MAINTENANCE_MODE=False

# --- AI Copilot (internal / self-hosted) ---
# Product chat uses Ollama only (see docs/OLLAMA_OPERATIONS_AND_UPDATES.md).
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
# Optional: path to ollama binary for sync_ollama_models / beat
# OLLAMA_CLI_PATH=ollama
# OLLAMA_PULL_TIMEOUT_SECONDS=3600
# Comma-separated extra models for sync_ollama_models (allowlisted names only)
# OLLAMA_SYNC_EXTRA_MODELS=
# Include AIModelRegistry active models in sync (1/true/yes)
# OLLAMA_SYNC_INCLUDE_REGISTRY=0
# Weekly Celery beat: guarded ollama pull (requires worker+beat on host with Ollama CLI)
# ENABLE_OLLAMA_MODEL_SYNC_BEAT=0
# Daily Celery beat: index_ai_knowledge (RAG); requires embeddings on worker host
# ENABLE_AI_KNOWLEDGE_INDEX_BEAT=0
# Daily platform health ticks (AutomationExecutionLog in platform admin)
# ENABLE_OPERATOR_VISIBILITY_HEARTBEAT_BEAT=0
# ENABLE_DATABASE_CONNECTIVITY_HEARTBEAT_BEAT=0
# Daily automation failure trend signal + thresholds
# ENABLE_AUTOMATION_FAILURE_TREND_BEAT=0
# AUTOMATION_FAILURE_TREND_LOOKBACK_HOURS=24
# AUTOMATION_FAILURE_TREND_MAX_FAILURES=10
# Weekly AI quality scorecard (runs aggregate_ai_metrics + ai_quality_scorecard)
# ENABLE_AI_QUALITY_SCORECARD_BEAT=0
# Playbook confidence guard (low score blocked unless override_reason provided)
# MIGRATION_PLAYBOOK_MIN_CONFIDENCE_SCORE=70
# Optional: comma order for status UI only; "gemini" is ignored if present.
# AI_PROVIDER_PREFERENCE=ollama,rules

# --- OCR Integration Runtime ---
# Used when Site Settings -> Receipt Verification Method is not "pattern"
# Tesseract fallback command (optional wrapper/script path)
MARKSHEET_OCR_COMMAND=
# Google Vision mode
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# AWS Textract mode
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- Ministry Connector Runtime (safe default: mock) ---
# mock = no outbound requests (payload preview only)
# live = send outbound requests to configured endpoints
MINISTRY_CONNECTOR_MODE=mock
RUN_INTEGRATION_PREFLIGHT=1

# Cartescolaire / school map bridge
CARTESCOLAIRE_API_BASE_URL=
CARTESCOLAIRE_API_PATH=/registry/import
CARTESCOLAIRE_API_TOKEN=

# DGI e-invoicing bridge
DGI_API_BASE_URL=
DGI_API_PATH=/einvoice/sync
DGI_CLIENT_ID=
DGI_CLIENT_SECRET=

# --- Marketing (optional) ---
# Example tenant slug for marketing copy and deep links (e.g. gilead-school after seed_gilead_demo_users).
# When MARKETING_DEMO_TENANT_URL is unset, the platform builds:
#   https://{TENANT_EXAMPLE_SLUG}.{MULTI_TENANT_BASE_DOMAIN}/
# TENANT_EXAMPLE_SLUG=gilead-school
# Explicit "Try demo" URL (overrides auto-build above when set)
# MARKETING_DEMO_TENANT_URL=https://demo.runmycampus.com/
# Hero / video (CDN or absolute URLs). Unset = use static SVG fallbacks via marketing_ai + template fallbacks.
# MARKETING_HERO_IMAGE_URL=
# MARKETING_HERO_VIDEO_URL=
# MARKETING_HERO_VIDEO_POSTER_URL=
# Optional: override AI asset keys (else static SVGs under static/images/marketing/)
# MARKETING_MIGRATION_FLOW_IMAGE_URL=
# MARKETING_SETUP_STUDIO_IMAGE_URL=
# MARKETING_ECOSYSTEM_IMAGE_URL=
# MARKETING_MARKETPLACE_IMAGE_URL=
# Regional / campaign JSON: compare_eu.json, slug_variant.json, etc. (docs/MARKETING_REGIONAL_JSON.md)
# MARKETING_CONTENT_REGION=eu
# MARKETING_CONTENT_VARIANT=
# A/B landing: line appended for hero_variant B when CMS landing_hero_ai_line unset (else built-in default)
# MARKETING_HERO_VARIANT_B_SUBLINE=
# Analytics script URL injected on marketing landing extrahead (e.g. GA, Hotjar)
# MARKETING_ANALYTICS_SCRIPT_URL=
# Calendly (or Cal.com) embed URL for /book-demo/; if unset, book-demo shows a request form
# MARKETING_CALENDLY_URL=
# Webhook URL for book-demo form submissions (POST JSON: name, email, school, message)
# MARKETING_DEMO_WEBHOOK_URL=
