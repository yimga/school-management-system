DEBUG=1
# Django 6 transition: treat bare-host URLField input as https in forms (default on in settings).
# FORMS_URLFIELD_ASSUME_HTTPS=0
SECRET_KEY=change-me-to-a-very-secure-random-key-min-50-chars
# Comma-separated. On Render, *.onrender.com is added automatically when RENDER=true.
ALLOWED_HOSTS=localhost,127.0.0.1
# Canonical production domain (public root + tenant wildcard).
# MULTI_TENANT_BASE_DOMAIN=runmycampus.com
# Manager host base URL (Studio system config links for super-only tools)
# MANAGER_PLATFORM_BASE_URL=https://manager.runmycampus.com
# OAuth redirect URI base for Zoom/Google/Microsoft/Slack (defaults to MANAGER_PLATFORM_BASE_URL when unset in production)
# OAUTH_CALLBACK_BASE_URL=https://manager.runmycampus.com

# ---------------------------------------------------------------------------
# LMS OAuth live-outbound env gates (W21 v4.00.89 + W22 v4.00.90).
# When unset (default), exchange_authorization_code_for_token, refresh_access_token,
# and push_grade_live return dry-run dicts shape-compatible with the real upstream
# response — useful for testing payload assembly without hitting prod.
# Set to "1" (or "true"/"yes"/"on") to fire real outbound HTTP. Requires the tenant
# to have provisioned OAuth2 client_id + client_secret with the LMS vendor.
# ---------------------------------------------------------------------------
# RMC_SCHOOLOGY_OAUTH_LIVE_OUTBOUND=0
# RMC_D2L_OAUTH_LIVE_OUTBOUND=0

# ---------------------------------------------------------------------------
# SAML 2.0 SP env gates (Waves 17/18/21).
# RMC_SAML_SP_PRIVATE_KEY_PEM / _CERT_PEM are the SP's signing keypair
# (PEM-encoded; armored or armorless both accepted). Required before turning
# on RMC_SAML_SP_SIGN_LOGOUT — without them, sign helpers return key_unset.
# ---------------------------------------------------------------------------
# RMC_SAML_SP_PRIVATE_KEY_PEM=
# RMC_SAML_SP_CERT_PEM=
# RMC_SAML_SP_SIGN_LOGOUT=0
# RMC_SAML_SP_SIGNATURE_ALG=rsa-sha256
# RMC_SAML_SIGNATURE_STRICT=0
# RMC_SAML_REQUIRE_ENCRYPTED_ASSERTION=0
# RMC_SAML_REQUIRE_ASSERTION_SIGNATURE=0
# RMC_SAML_REQUIRE_REDIRECT_SIGNATURE=0
# RMC_SAML_SP_ENTITY_ID=https://manager.runmycampus.com/sso/saml/metadata.xml
# RMC_SAML_IDP_SSO_URL=
# RMC_SAML_LOGIN_BUTTON_LABEL=Sign in with SSO
# Multi-IdP federation registry (JSON-encoded). Maps domain or wildcard suffix
# to IdP entry: {"@school.edu": {"idp_target": "https://idp.school.edu/sso", ...}}
# RMC_SAML_MULTI_IDP_REGISTRY=
# Per-tenant SAML attribute map overrides (JSON-encoded by tenant_schema).
# RMC_SAML_ATTR_FIRST_NAME=
# RMC_SAML_ATTR_LAST_NAME=
# RMC_SAML_ATTR_EMAIL=
# HRD per-domain mapping for single-IdP fallback.
# RMC_SAML_HRD_MAPPING=
# SP metadata cache lifetime (seconds, default 86400 = 24h).
# RMC_SAML_METADATA_CACHE_SECONDS=86400
# Tenant school URL for Approval hub links when browsing Studio on manager host
# STUDIO_APPROVAL_HUB_TENANT_BASE_URL=https://your-school.runmycampus.com
# Temporary legacy redirect support during domain cutover.
# MULTI_TENANT_LEGACY_BASE_DOMAINS=legacy.runmycampus.com
# SESSION_COOKIE_DOMAIN=.runmycampus.com
# CSRF_COOKIE_DOMAIN=.runmycampus.com
# Production HTTPS (e.g. Render): include canonical app domains.
# Example: https://runmycampus.com,https://*.runmycampus.com,https://school-management-system-2kzk.onrender.com
# CSRF_TRUSTED_ORIGINS=

# Database Configuration
# Option A: Full URL (recommended for Render and most platforms)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Render: paste the Internal Database URL from your Postgres service.
DATABASE_URL=
# direct | session | transaction. Transaction is rejected until tenant context
# is transaction-local and real PgBouncer interleaving tests pass.
DB_POOL_MODE=direct
# Render Postgres: keep ≤120s to avoid SSL "unexpected eof" on stale pooled sockets.
DB_CONN_MAX_AGE=120
# Seconds before a new TCP connect to Postgres fails (avoids hung gthread workers).
DB_CONNECT_TIMEOUT=10
# TCP keepalive on pooled connections (default on; set DB_TCP_KEEPALIVES=0 to disable).
DB_TCP_KEEPALIVES=1
DB_DISABLE_SERVER_SIDE_CURSORS=0

# Bounded, content-free browser layout telemetry. Set 0 for immediate rollback.
RMC_LAYOUT_OBSERVABILITY_ENABLED=1
# Secret used only to sign reviewed pilot/production promotion evidence.
# Keep blank unless the promotion workflow is being operated.
INTELLIGENCE_PROMOTION_SIGNING_KEY=
BROWSER_AI_ENABLED=0
BROWSER_AI_MANIFEST_PATH=
BROWSER_AI_MIN_DEVICE_MEMORY_GB=4
BROWSER_AI_MIN_FREE_BYTES=536870912
LOCAL_VOICE_ENABLED=0
LOCAL_VOICE_STT_ENDPOINT=
LOCAL_VOICE_TTS_ENDPOINT=
LOCAL_VOICE_ALLOWED_HOSTS=
LOCAL_VOICE_LANGUAGES=en
LOCAL_VOICE_TIMEOUT_SECONDS=20
LOCAL_VOICE_MAX_AUDIO_BYTES=2000000
LOCAL_VOICE_MAX_TRANSCRIPT_CHARS=4000
LOCAL_VOICE_MAX_TTS_CHARS=2000
LOCAL_VOICE_MAX_TTS_BYTES=4000000
LOCAL_VOICE_RATE_LIMIT_PER_MINUTE=10

# Local manage.py test: if DATABASE_URL points at Postgres you cannot reach, tests may hang on "Creating test database…".
# Fix: export RMC_TEST_LOCAL_SQLITE=1 (and optionally RMC_SQLITE_TEST_MEMORY=1). See docs/TEST_DATABASE.md and scripts/smoke_marketing_public_story.sh.

# Option B: Separate vars (used if DATABASE_URL is not set; config builds the URL)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=school_platform_db
# DB_USER=
# DB_PASSWORD=

# SQLite only: use a different file when db.sqlite3 is corrupted or locked (e.g. db_fresh.sqlite3)
# DB_FILE=db_fresh.sqlite3

# Metadata / Batch 14 Phase 5b: legacy siteconfig_dynamicfield* tables removed — bridge env vars are ignored (no-ops).
# METADATA_DYNAMICFIELD_SITECONFIG_FALLBACK=0
# METADATA_DYNAMICFIELD_DUAL_WRITE_FROM_SITECONFIG=0

# --- Security & Credentials (NEVER commit real values!) ---

# Session: for shared computers use 15–30 min inactivity (seconds = minutes × 60)
# Leave empty to use SESSION_COOKIE_AGE (default 4 hours)
# SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# SESSION_COOKIE_AGE=14400
# SESSION_SAVE_EVERY_REQUEST=1
# SESSION_EXPIRE_AT_BROWSER_CLOSE=1

# Webhook Security Configuration
WEBHOOK_RATE_LIMIT=100
# Optional: HMAC secret for POST /api/oneroster/v1p1/roster-webhook (district roster push)
# ONEROSTER_WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_ALGORITHM=sha256
WEBHOOK_SIGNATURE_HEADER=X-Signature
# Comma-separated list of allowed IPs for webhooks (leave empty to allow all)
WEBHOOK_IP_WHITELIST=
OBSERVABILITY_API_KEY=

# Control plane: URL to incident runbooks (health dashboard links here). Required when running control plane.
# CONTROL_PLANE_RUNBOOKS_URL=https://docs.example.com/runbooks

# Control plane: comma-separated allowlist of role tokens that grant operator
# access to manager-host surfaces (API Center, Studio OS, /super/, etc.).
# Defaults to SUPERADMIN-only; superusers always pass regardless. Env-only by
# design — see _operator_roles() in apps/schools/control_plane.py for the
# privilege-escalation rationale (admin-UI editing would let any compromised
# SUPERADMIN promote peers without an auditable code/deploy trail).
# CONTROL_PLANE_OPERATOR_ROLES=SUPERADMIN,ADMIN

# --- Policy / Marketplace (Phase 7, 24.12) — non-negotiable, default on ---
# Use blueprint bundles in resolver (1 = yes). Required; default 1.
# POLICY_USE_BUNDLES=1
# Per-tenant policy cache TTL in seconds. Required for scale; default 300. Set 0 only to disable for debugging.
# POLICY_CACHE_TTL=300
# Comma-separated Django app labels that third-party marketplace apps may use for schema patches. Empty = none (24.12).
# THIRD_PARTY_SCHEMA_PATCH_ALLOWLIST=

# Payment Provider Integration Secrets
# These should be set via environment variables or Django admin PaymentIntegration model
# MTN MoMo Configuration
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/finance/webhook/mtn_momo/

# Orange Money Configuration
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_CALLBACK_URL=https://yourdomain.com/finance/webhook/orange_money/

# --- LibreOffice Online / Collabora ---
# Public collabora host URL (no trailing slash)
# Example: https://collabora.runmycampus.com
COLLABORA_BASE_URL=
# Shared secret used to sign WOPI access tokens
WOPI_SHARED_SECRET=

# --- Email Configuration (for notifications + post-provision welcome mail) ---
# Local dev: console backend. Production Render: Brevo SMTP (free ~300/day) — docs/RENDER_EMAIL_SETUP.md
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@runmycampus.com

# --- Admin Settings ---
ADMIN_URL_PREFIX=admin

# --- Caching (Redis optional for production) ---
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
REDIS_URL=

# --- Background tasks (Celery) ---
# Broker URL for Celery. Falls back to REDIS_URL when unset. When BOTH are
# empty (e.g. Render free tier with no Redis), tasks run INLINE during the
# request so deferred work (webhook delivery, low-balance notices) still
# executes instead of sitting PENDING forever. A real broker is always
# preferred for production throughput.
CELERY_BROKER_URL=
# Set to 1 ONLY if you have a separate worker that will drain PENDING tasks and
# you do NOT want the inline fallback (keeps tasks queued instead of running
# them in-request when no broker is configured).
RMC_DISABLE_EAGER_FALLBACK=

# --- Media storage (uploaded files: logos, documents, photos) ---
# Default (all blank): local filesystem at MEDIA_ROOT — fine for a single box,
# but NOT durable on ephemeral hosts (e.g. Render free tier loses media on
# redeploy). For durability + scale, point at any S3-compatible object store
# (self-hosted MinIO is FOSS; or Cloudflare R2 / Backblaze B2 / AWS S3 / a
# regional/edge bucket). No code change — just set these and
# `pip install django-storages[s3]`.
MEDIA_STORAGE_BACKEND=          # empty=local fs; s3 | minio | r2 to enable object storage
AWS_S3_ENDPOINT_URL=           # e.g. https://<minio-host>:9000 or https://<acct>.r2.cloudflarestorage.com (blank = real AWS S3)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=            # 'auto' for R2; e.g. us-east-1 for AWS
AWS_S3_ADDRESSING_STYLE=path   # 'path' for MinIO; 'virtual' ok for AWS/R2
AWS_QUERYSTRING_AUTH=1         # 1=signed URLs (private bucket); 0=public-read CDN
AWS_DEFAULT_ACL=              # blank=bucket default; e.g. public-read for CDN delivery

# --- Field-encryption key ring (SH-6) ---
# Default: keys come from env below (DJANGO_CRYPTOGRAPHY_KEYS / _KEY).
# Opt-in: source the whole MultiFernet ring from HashiCorp Vault (KV v2).
# When SOURCE is unset/'env', nothing below touches Vault (zero behavior change).
# See docs/SECURITY_KEYS.md §2 "Vault-sourced key ring".
DJANGO_CRYPTOGRAPHY_KEYS_SOURCE=          # empty/'env' = env keys; 'vault' = source from Vault
# VAULT_ADDR / VAULT_TOKEN are shared with the audit-signing backend.
DJANGO_CRYPTOGRAPHY_VAULT_MOUNT=secret    # KV v2 mount
DJANGO_CRYPTOGRAPHY_VAULT_PATH=           # secret path (required when source=vault), e.g. rmc/crypto-keys
DJANGO_CRYPTOGRAPHY_VAULT_FIELD=keys      # field holding the newest-first ring (JSON array or comma/newline list)
DJANGO_CRYPTOGRAPHY_VAULT_CACHE_SECONDS=300
DJANGO_CRYPTOGRAPHY_VAULT_DRY_RUN=0       # 1 = skip network, fall back to env keys (CI/dev)

# --- Logging ---
LOG_LEVEL=INFO

# --- Region & locale (default: Buea/Cameroon) ---
# For Buea/Cameroon: use REGION_CODE=CMR and TIME_ZONE=Africa/Douala
# For other countries set accordingly (e.g. NGA/Africa/Lagos, USA/America/New_York)
REGION_CODE=CMR
TIME_ZONE=Africa/Douala

# When True, show region switcher and allow switching region in session (multi-region deployments)
ENABLE_MULTI_REGION=False

# --- Feature Flags ---
ENABLE_PARENT_PORTAL=True
ENABLE_TEACHER_PORTAL=True
MAINTENANCE_MODE=False

# --- Deployment profile (online Render | edge LAN hub | hybrid) ---
# online = default SaaS on Render; edge = school LAN hub; hybrid = Render + RMC_HUB_BASE_URL fallback
RMC_DEPLOYMENT_PROFILE=online
# RMC_HUB_BASE_URL=http://192.168.1.100:8000
RMC_AUTO_APPLY_OFFLINE_BUNDLE_ON_PROVISION=1
# Apply bundle to existing tenants: python manage.py apply_offline_mode_bundle --all-active

# --- AI Copilot (Option A: one cloud model + rules fallback) ---
# Canonical: docs/AI_DEPLOYMENT_POSTURE.md — Render SaaS uses OpenAI direct (no LiteLLM VM).
# Posture: offline-first for attendance/grades/payments (enable_offline_mode per tenant);
# live AI needs server connectivity (Render cloud API, hub Ollama, or rules fallback).
# Teacher phones do NOT run models locally.
# OpenAI: create key at platform.openai.com; set API host to api.openai.com (not platform.openai.com).
# LITELLM_PROXY_URL=https://api.openai.com
# LITELLM_API_KEY=
# LITELLM_MODEL=gpt-5.4-mini
# IMPORTANT: LITELLM_MODEL must be a model your key can actually call. If unset it
# defaults to gpt-5.4-mini — if your endpoint does not expose that exact name, the
# models probe passes but every chat completion 404s and the copilot drops to
# "Guided/rules" mode. The AI Center now shows the exact reason (http_404/401/timeout).
# Cloud-AI health-probe tuning (all optional):
# LITELLM_PROBE_TIMEOUT_SECONDS=4      # raise (e.g. 10) on slow/free-tier hosts; clamp 1..30
# LITELLM_HEALTH_DEEP_PROBE=0          # 1 = probe a real 1-token completion (definitive, tiny spend)
# LITELLM_LASTGOOD_GRACE_SECONDS=600   # keep provider "live" through a transient timeout; clamp 60..3600
# Product AI: gateway tiers follow RMC_DEPLOYMENT_PROFILE (online → LITELLM_* when set, else Ollama; edge → Ollama).
# Override per task only via Django settings.AI_GATEWAY_TASK_TIERS dict.
# Embeddings/RAG default to Ollama when AI_EMBEDDING_BACKEND is unset (see services/embeddings.py).
# Verify after setup: python scripts/verify_ollama_live.py --invoke
# See docs/OLLAMA_OPERATIONS_AND_UPDATES.md.
AI_GATEWAY_ENABLED=1
AI_ALLOW_RULES_FALLBACK=1
# Auto-pick first reachable host (127.0.0.1, localhost, host.docker.internal, WSL→Windows).
# Set OLLAMA_AUTO_DISCOVER=0 to pin only OLLAMA_BASE_URL / OLLAMA_ENDPOINT.
OLLAMA_AUTO_DISCOVER=1
# Production: 1 = never show template rules "answers" when Ollama is down (default on when DEBUG=0).
# Intelligent degraded mode when Ollama is down (default). Set OLLAMA_REQUIRE_LIVE=1 only to block fallback.
OLLAMA_REQUIRE_LIVE=0
# Dev/on-prem: spawn `ollama serve` once when inference runs and daemon is down (off on cloud deploy).
OLLAMA_AUTO_START=1
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL_CANDIDATES=http://192.168.1.50:11434
# First-line support engine room (RAG + zero-fluff persona on /api/ai/support-assistant/)
AI_ENGINE_ROOM_SUPPORT=1
AI_ENGINE_ROOM_TIMEOUT_SECONDS=15
AI_ENGINE_ROOM_MAX_INPUT_TOKENS=6000
# AI Center governed model + RAG (build: ollama create ai-center-master -f ai/Modelfile)
# Legacy dashboard label; live routing uses RMC_DEPLOYMENT_PROFILE + LITELLM_* / Ollama tiers.
AI_GATEWAY_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ai-center-master
AI_CENTER_LOG_PROMPTS=0
AI_CENTER_MAX_CONTEXT_DOCS=8
AI_CENTER_TIMEOUT_SECONDS=30
# Optional: path to ollama binary for sync_ollama_models / beat
# OLLAMA_CLI_PATH=ollama
# OLLAMA_PULL_TIMEOUT_SECONDS=3600
# Comma-separated extra models for sync_ollama_models (allowlisted names only)
# OLLAMA_SYNC_EXTRA_MODELS=
# Include AIModelRegistry active models in sync (1/true/yes)
# OLLAMA_SYNC_INCLUDE_REGISTRY=0
# Weekly Celery beat: guarded ollama pull (requires worker+beat on host with Ollama CLI)
# Production: enable weekly Ollama pull + engine-room smoke (requires Ollama CLI on worker)
# ENABLE_OLLAMA_MODEL_SYNC_BEAT=1
# Production: daily RAG re-index (requires embeddings on worker host)
# ENABLE_AI_KNOWLEDGE_INDEX_BEAT=1
# Daily platform health ticks (AutomationExecutionLog in platform admin)
# ENABLE_OPERATOR_VISIBILITY_HEARTBEAT_BEAT=0
# ENABLE_DATABASE_CONNECTIVITY_HEARTBEAT_BEAT=0
# Daily automation failure trend signal + thresholds
# ENABLE_AUTOMATION_FAILURE_TREND_BEAT=0
# AUTOMATION_FAILURE_TREND_LOOKBACK_HOURS=24
# AUTOMATION_FAILURE_TREND_MAX_FAILURES=10
# Weekly AI quality scorecard (runs aggregate_ai_metrics + ai_quality_scorecard)
# ENABLE_AI_QUALITY_SCORECARD_BEAT=0
# -----------------------------------------------------------------
# AI/ML predictive batches (Waves 1-10, sms-v2.92+). Each opt-in via env
# var so a fresh deploy doesn't start scoring before operators have
# registered an artifact via `bootstrap_at_risk_registry`. See
# docs/AI_ML_WAVES_1_10_DEPLOYMENT_RUNBOOK_2026_05_16.md.
# Daily at 02:00 — nightly RiskFactor recompute (Wave 1).
# ENABLE_AT_RISK_NIGHTLY_BEAT=0
# Daily at 03:00 — nightly grade-prediction recompute (Wave 4).
# Skip until a production grade artifact is promoted (heuristic baseline
# runs even without an artifact, but most schools wait for v1 model).
# ENABLE_GRADE_PREDICTION_NIGHTLY_BEAT=0
# Daily at 03:30 — refresh student embeddings for semantic search (Wave 5).
# Requires a working embedding provider on the worker host (Ollama or OpenAI-compatible).
# ENABLE_STUDENT_EMBEDDINGS_BEAT=0
# Daily at 06:00 — fan out AI-narrated risk digest to RiskDigestRecipient rows (Wave 8).
# Requires per-school recipients seeded via admin or `seed_default_digest_recipients`.
# ENABLE_RISK_DIGEST_BEAT=0
# Daily at 07:00 — PSI drift watchdog over last 7 days vs sidecar reference (Wave 1).
# Requires a captured reference distribution at <artifact>.distribution.json.
# ENABLE_AT_RISK_DRIFT_WATCHDOG_BEAT=0
# -----------------------------------------------------------------
# Wave 9 — semantic search via pgvector (vs JSON cosine loop). Requires:
#   1. PostgreSQL with the `vector` extension installed on the DB
#   2. `migrate_embeddings_to_pgvector` to have run at least once
#   3. Flip this to True. Search falls back to JSON path on any DB error.
# The migrate cmd appends this flag itself when run with --write-env-flag,
# which the predeploy script does automatically — so you don't normally
# need to set it manually.
# PGVECTOR_ENABLED=False
# Render predeploy: run pgvector migrate + verify on every deploy.
# Default 1 (on); commands refuse cleanly on non-Postgres so this is safe
# for sqlite dev. Set to 0 to skip (tenants pre-5k embedding scale, or
# environments without the vector extension installable).
# RUN_PGVECTOR_MIGRATE=1
# Predeploy skips pgvector migrate/verify when no embedding rows exist yet
# (fresh DB). After `build_student_embeddings` / `index_ai_knowledge`, re-deploy
# or run migrate_embeddings_to_pgvector manually with --dimensions if needed.
# EMAIL_SIGNING_SILENCE_CONSOLE_WARN=1
# EMAIL_SIGNING_REQUIRED=0
# -----------------------------------------------------------------
# Wave E — data residency / geo-alignment.
# DATA_RESIDENCY_ENFORCE controls what happens when a tenant's
# `data_region` (regulatory) doesn't match its operational `regional_cluster`:
#   0 (default) → soft-log a warning, request still served
#   1           → raise CrossRegionWriteError mid-request (500 to caller)
# Only flip to 1 after:
#   (a) provisioning region replicas in DATABASES, and
#   (b) running `verify_data_residency --fix-derive --strict` until clean.
# DATA_RESIDENCY_ENFORCE=0
# Render predeploy: gate the deploy on residency readiness (region replicas
# present + every tenant aligned). Opt-in because most deploys don't yet
# have region replicas. Flip to 1 alongside provisioning the replicas; the
# next deploy will fail-loud if any tenant is unaligned. Pair with
# DATA_RESIDENCY_ENFORCE=1 only AFTER this preflight is green.
# RUN_VERIFY_RESIDENCY_READINESS=0
# -----------------------------------------------------------------
# Render predeploy: idempotent bootstrap of the AtRiskModelArtifact registry.
# Default 1 (on); only does work on a fresh DB with no PRODUCTION artifact
# registered. Skipped automatically when the registry already has a
# PRODUCTION row, so safe to leave on permanently.
# RUN_BOOTSTRAP_AT_RISK_REGISTRY=1
# Render predeploy: discover ADMIN/PRINCIPAL/PROPRIETOR users and create
# disabled RiskDigestRecipient rows so they can opt in later. Opt-in
# (default 0) because users may not exist on a fresh deploy. Idempotent.
# RUN_SEED_DIGEST_RECIPIENTS=0
# Playbook confidence guard (low score blocked unless override_reason provided)
# MIGRATION_PLAYBOOK_MIN_CONFIDENCE_SCORE=70
# Optional: comma order for status UI only; "gemini" is ignored if present.
# AI_PROVIDER_PREFERENCE=ollama,rules
# Support ticket suggestions: include tenant KB/FAQ excerpts in the prompt (1/true/yes).
# SUPPORT_AI_KB_CONTEXT=1
# Enqueue Celery triage after portal support form creates GlobalSupportTicket (requires worker).
# SUPPORT_AI_AUTO_TRIAGE_ON_CREATE=0
# Auto-create KB drafts from zero-result clusters when hit_count threshold met (HITL publish still required).
# Defaults ON when RMC_ENVIRONMENT/DJANGO_ENV is staging|production; override with 0 locally.
# HELP_ZERO_RESULT_AUTO_DRAFT_KB=0
# HELP_ZERO_RESULT_AUTO_DRAFT_HITS=5
# RMC_PRODUCT_MCP_ENABLED=0
# GEOS_A11Y_E2E=0
# Email operator pool on new GlobalSupportTicket (1/true/yes).
# SUPPORT_TICKET_NOTIFY_EMAIL=1
# Extra in-app Messages to operators (excluding primary recipient).
# SUPPORT_TICKET_NOTIFY_INAPP=1
# Per-operator Message fan-out (noisy). Default off: operators use the digest email instead.
# SUPPORT_TICKET_INAPP_FANOUT_OPERATORS=0
# Email tenant when an operator posts a submitter-visible reply (not when they add their own follow-up).
# SUPPORT_TICKET_NOTIFY_SUBMITTER_ON_VISIBLE_REPLY=1
# Best-effort FCM/web push to submitter (requires tenant push integration + device token).
# SUPPORT_TICKET_PUSH_SUBMITTER_ON_VISIBLE_REPLY=0
# Best-effort push to operator pool on new ticket (same constraints).
# SUPPORT_TICKET_PUSH_OPERATORS_ON_CREATE=0
# Signed webhook (HMAC SHA256 in X-RunMyCampus-Signature). Delivery is queued via Celery with retries.
# Additional URLs: GlobalSupportTicketWebhookEndpoint in platform Django admin (plus this legacy URL).
# SUPPORT_TICKET_WEBHOOK_URL=
# SUPPORT_TICKET_WEBHOOK_SECRET=

# --- OCR Integration Runtime ---
# Used when Site Settings -> Receipt Verification Method is not "pattern"
# Tesseract fallback command (optional wrapper/script path)
MARKSHEET_OCR_COMMAND=
# Google Vision mode
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# AWS Textract mode
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- Ministry Connector Runtime (safe default: mock) ---
# mock = no outbound requests (payload preview only)
# live = send outbound requests to configured endpoints
MINISTRY_CONNECTOR_MODE=mock
RUN_INTEGRATION_PREFLIGHT=1

# Cartescolaire / school map bridge
CARTESCOLAIRE_API_BASE_URL=
CARTESCOLAIRE_API_PATH=/registry/import
CARTESCOLAIRE_API_TOKEN=

# DGI e-invoicing bridge
DGI_API_BASE_URL=
DGI_API_PATH=/einvoice/sync
DGI_CLIENT_ID=
DGI_CLIENT_SECRET=

# --- Marketing (optional) ---
# Example tenant slug for marketing copy and deep links (e.g. demo-school after seed_demo_tenant_users).
# When MARKETING_DEMO_TENANT_URL is unset, the platform builds:
#   https://{TENANT_EXAMPLE_SLUG}.{MULTI_TENANT_BASE_DOMAIN}/
# TENANT_EXAMPLE_SLUG=gilead-school
# Explicit "Try demo" URL (overrides auto-build above when set)
# MARKETING_DEMO_TENANT_URL=https://demo.runmycampus.com/
# Nightly Celery beat: re-seed the public demo tenant (same slug as ensure_demo_environment).
# ENSURE_DEMO_CRON_SLUG=demo-school
# After self-service email verify: skip the forced /activation/first-action/ gate for tenant admins.
# DISABLE_SCHOOL_ACTIVATION_GATE=0
# Hero / video (CDN or absolute URLs). Unset = use static SVG fallbacks via marketing_ai + template fallbacks.
# MARKETING_HERO_IMAGE_URL=
# MARKETING_HERO_VIDEO_URL=
# MARKETING_HERO_VIDEO_POSTER_URL=
# Optional: override AI asset keys (else static SVGs under static/images/marketing/)
# MARKETING_MIGRATION_FLOW_IMAGE_URL=
# MARKETING_SETUP_STUDIO_IMAGE_URL=
# MARKETING_ECOSYSTEM_IMAGE_URL=
# MARKETING_MARKETPLACE_IMAGE_URL=
# Regional / campaign JSON: compare_eu.json, slug_variant.json, etc. (docs/MARKETING_REGIONAL_JSON.md)
# MARKETING_CONTENT_REGION=eu
# MARKETING_CONTENT_VARIANT=
# A/B landing: line appended for hero_variant B when CMS landing_hero_ai_line unset (else built-in default)
# MARKETING_HERO_VARIANT_B_SUBLINE=
# Analytics script URL injected on marketing landing extrahead (e.g. GA, Hotjar)
# MARKETING_ANALYTICS_SCRIPT_URL=
# Calendly (or Cal.com) embed URL for /book-demo/; if unset, book-demo shows a request form
# MARKETING_CALENDLY_URL=
# Webhook URL for book-demo form submissions (POST JSON: name, email, school, message)
# MARKETING_DEMO_WEBHOOK_URL=
# Dedicated webhook for /contact/submit/ (same JSON shape + inquiry fields); falls back to MARKETING_DEMO_WEBHOOK_URL if unset
# MARKETING_CONTACT_WEBHOOK_URL=
# Signed archive-before-purge compliance retention (use independent secrets)
AUDIT_ARCHIVE_ROOT=
AUDIT_ARCHIVE_SIGNING_KEY=
AUDIT_RETENTION_APPROVAL_TOKEN=
