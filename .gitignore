*.webm
*.mp4
*.png
# Marketing ship assets (committed; CI + fresh clones must pass hero gate)
!static/marketing/video/hero-home.mp4
!static/marketing/video/loops/
!static/marketing/video/loops/*.mp4
!static/marketing/video/loops/*.webm
!static/marketing/img/hero-home-poster.svg
!static/marketing/fonts/**/*.woff2
!static/marketing/css/marketing-critical.min.css
!static/marketing/css/marketing-enhanced.min.css
!static/marketing/css/marketing-bundles.manifest.json
# Companion-extension MV3 icons (committed ship assets; manifest.json references
# them and fresh clones/CI must pass the companion-icon gate). Generated by
# scripts/generate_companion_extension_icons.py (idempotent, byte-deterministic).
!companion-extension/icons/icon-16.png
!companion-extension/icons/icon-48.png
!companion-extension/icons/icon-128.png

# Merge conflict artifacts (do not commit).
# Anchored to cloud-sync "conflict copy" names (a space or hyphen precedes
# "Conflict") so legit modules like apps/sync_engine/conflict_resolver.py are
# NOT swallowed on case-insensitive (Windows) git — which silently kept that
# import-required module out of the repo and broke CI.
*_Conflict.py
*[ -]Conflict*.py
# Django migrations must never be gitignored by the rules above (Render deploy drift).
!**/migrations/*_Conflict.py
!**/migrations/*[ -]Conflict*.py

# Local video-frame extraction (audit artefacts; never committed)
.video-frames/

# Local dev artifacts (screenshots, verify dbs)
/tmp/

# Playwright manager auth state (session cookies; regenerated by seed script)
artifacts/manager-playwright-auth.json
# Real-host admin browser sessions contain reusable authenticated cookies and
# are local QA inputs only. JSON evidence reports remain commit-eligible.
artifacts/django-admin-canvas-live/real-host-sessions.local.json

# Full pre-deploy gate raw logs (commit docs/generated/pre_deploy_gate_run_summary.json only)
docs/generated/pre_deploy_gate_run.full.txt
artifacts-evidence/pre_deploy/

# Release hygiene cleanup (batch 1507, 2026-05-25). The artifacts-evidence/ tree
# is the in-tree home for sludge that scanners/verifiers regenerate but should
# not ship in release archives. .gitattributes also export-ignores it.
artifacts-evidence/
var/evidence/click-repro/
var/cand.joblib
var/at_risk_v2_2026q2.joblib
var/at_risk/
var/help-*
var/feedback-*
var/all-hc-*
var/audit-1310-*
var/single-staff-*
var/last-test-*
var/verify-interaction-*
var/test_*.sqlite3*
var/*.sqlite3-shm
var/*.sqlite3-wal
var/lens_test_out.txt
var/lens_tests_result*.txt
var/shard*_nohup.*
var/subagent_nohup.out
var/smoke-results-multi/
var/tenant-abrupt-end-e2e.lock
var/*.partial.json

# Pseudo-locale QA catalog (M21/G3). Machine-generated by
# `manage.py generate_pseudo_locale` from locale/en for i18n QA (hardcoded-string
# + layout-overflow eyeballing); regenerable, never shipped. Ignored so a
# `git add -A` cannot commit it (which would also trip scan_locale_coverage,
# since that gate walks the locale/ dir and demands a declaration per catalog).
locale/en_XA/
