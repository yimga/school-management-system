db_step4.sqlite3

# Local generated evidence is kept outside release source archives.
*.webm
*.mp4
*.png

# Merge conflict artifacts (do not commit)
*_Conflict.py
*Conflict*.py

# Local video-frame extraction (audit artefacts; never committed)
.video-frames/
