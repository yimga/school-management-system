# SQLite and DB artifacts (repo hygiene — do not commit)
db_working.sqlite3
db_*.sqlite3
*.sqlite3
*.sqlite3-journal
*.sqlite3.malformed
*.sqlite3.corrupted
/data/db_live.sqlite3
db_fresh.sqlite3
