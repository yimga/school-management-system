# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Environment and secrets
.env
.env.local
*.pem

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
default_*.sqlite3
/media
/staticfiles

# IDE
.idea/
.vscode/
.cursor/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
nul

# Node (if used)
node_modules/
npm-debug.log*

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/
# Ephemeral dirs created by tests on Windows — git may warn "Permission denied"
# when scanning if ACLs block enumeration; ignore so status/clean stay quiet.
.tmp_test_raw_sql_usage/
pytest-cache-files-*/
var/pytest-cache-files-*/
var/tmp/
.tmp_test_artifacts/
.django_test_dbs/
full_test_run.txt
test_output.txt
gate_log.txt
gate_log2.txt
tmp_aifail.txt
tmp_*.txt

# Backups and temp
*.bak
*.tmp
/logs/
/backups/
/artifacts/db_snapshots/
/tmp/screenshots/
/test-results/

# SQLite and DB artifacts (repo hygiene — do not commit)
db_working.sqlite3
db_*.sqlite3
*.sqlite3
*.sqlite3-journal
*.sqlite3.malformed
*.sqlite3.corrupted
/data/db_live.sqlite3
db_fresh.sqlite3
db_buea_seed.sqlite3
db_step4.sqlite3

# Local generated evidence is kept outside release source archives.
*.webm
*.mp4
*.png
# Marketing ship assets (committed; CI + fresh clones must pass hero gate)
!static/marketing/video/hero-home.mp4
!static/marketing/video/loops/
!static/marketing/video/loops/*.mp4
!static/marketing/video/loops/*.webm
!static/marketing/img/hero-home-poster.svg
!static/marketing/fonts/**/*.woff2
!static/marketing/css/marketing-critical.min.css
!static/marketing/css/marketing-enhanced.min.css
!static/marketing/css/marketing-bundles.manifest.json

# Merge conflict artifacts (do not commit)
*_Conflict.py
*Conflict*.py
# Django migrations must never be gitignored by the rules above (Render deploy drift).
!**/migrations/*_Conflict.py
!**/migrations/*Conflict*.py

# Local video-frame extraction (audit artefacts; never committed)
.video-frames/

# Local dev artifacts (screenshots, verify dbs)
/tmp/

# Playwright manager auth state (session cookies; regenerated by seed script)
artifacts/manager-playwright-auth.json

# Release hygiene cleanup (batch 1507, 2026-05-25). The artifacts-evidence/ tree
# is the in-tree home for sludge that scanners/verifiers regenerate but should
# not ship in release archives. .gitattributes also export-ignores it.
artifacts-evidence/
var/evidence/click-repro/
var/cand.joblib
var/at_risk_v2_2026q2.joblib
var/at_risk/
var/help-*
var/feedback-*
var/all-hc-*
var/audit-1310-*
var/single-staff-*
var/last-test-*
var/verify-interaction-*
