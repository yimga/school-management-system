# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
!static/js/dist/
!static/js/dist/world-globe.mount.js
build/

# Virtual environments
.venv/
venv/
env/

# Environment and secrets
.env
.env.local
# Backups of a live .env carry every secret it held -- DB password, SECRET_KEY,
# encryption keys. The key-rotation runbook tells operators to snapshot .env
# before editing, and a self-hosted box IS a git checkout, so an un-ignored
# .env.bak is a committable secrets file. Tracked *.example templates are
# unaffected: these patterns only match .bak names.
.env.bak*
*.env.bak*
.env.backup*
*.pem

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
default_*.sqlite3
/media
/staticfiles

# IDE
.idea/
.vscode/
.cursor/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
nul

# Node (if used)
node_modules/
npm-debug.log*

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/
# Ephemeral dirs created by tests on Windows — git may warn "Permission denied"
# when scanning if ACLs block enumeration; ignore so status/clean stay quiet.
.tmp_test_raw_sql_usage/
pytest-cache-files-*/
var/pytest-cache-files-*/
var/tmp/
# Tenant DR immutable snapshots — encrypted, but still tenant PII + password
# hashes at rest. Must never be swept into version control by a `git add .`.
var/tenant_snapshots/
.tmp_test_artifacts/
.django_test_dbs/
full_test_run.txt
test_output.txt
gate_log.txt
gate_log2.txt
tmp_aifail.txt
tmp_*.txt

# Backups and temp
*.bak
*.tmp
/logs/
/backups/
/artifacts/db_snapshots/
/tmp/screenshots/
/test-results/

# SQLite and DB artifacts (repo hygiene — do not commit)
db_working.sqlite3
db_*.sqlite3
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3.malformed
*.sqlite3.corrupted

# Throwaway debug / audit artifacts (live HTML captures, runserver logs, probes)
/artifacts/*.html
/artifacts/*.log
/artifacts/*.log.err
/artifacts/*.txt
/artifacts/*.cjs

# Anything a human named ".local." is machine-local by intent, and some of it is
# CREDENTIAL material. The known case -- real-host-sessions.local.json, which holds live
# Django sessionids for manager.runmycampus.com and a tenant host -- already has its own
# rule further down, added when someone noticed that specific file. This is the CLASS
# rule, so the next such file is covered before anyone notices it: a session id is a
# bearer token, and one blanket `git add -A` is all it takes to publish one to a shared
# remote. The companion *-local.ps1 runner was NOT previously ignored; it carries no
# secret itself, only reads that JSON, but it is still machine-local scratch.
*.local.json
*-local.ps1
# ...except the one a human is meant to keep in the repo. Already tracked, so git would
# honour it regardless; stated so the rule above cannot be read as retiring it.
!.claude/settings.local.json
/data/db_live.sqlite3
db_fresh.sqlite3
db_buea_seed.sqlite3
db_step4.sqlite3

# Local generated evidence is kept outside release source archives.
*.webm
*.mp4
*.png
# Marketing ship assets (committed; CI + fresh clones must pass hero gate)
!static/marketing/video/hero-home.mp4
!static/marketing/video/loops/
!static/marketing/video/loops/*.mp4
!static/marketing/video/loops/*.webm
!static/marketing/img/hero-home-poster.svg
!static/marketing/fonts/**/*.woff2
!static/marketing/css/marketing-critical.min.css
!static/marketing/css/marketing-enhanced.min.css
!static/marketing/css/marketing-bundles.manifest.json
# Companion-extension MV3 icons (committed ship assets; manifest.json references
# them and fresh clones/CI must pass the companion-icon gate). Generated by
# scripts/generate_companion_extension_icons.py (idempotent, byte-deterministic).
!companion-extension/icons/icon-16.png
!companion-extension/icons/icon-48.png
!companion-extension/icons/icon-128.png

# Merge conflict artifacts (do not commit).
# Anchored to cloud-sync "conflict copy" names (a space or hyphen precedes
# "Conflict") so legit modules like apps/sync_engine/conflict_resolver.py are
# NOT swallowed on case-insensitive (Windows) git — which silently kept that
# import-required module out of the repo and broke CI.
*_Conflict.py
*[ -]Conflict*.py
# Django migrations must never be gitignored by the rules above (Render deploy drift).
!**/migrations/*_Conflict.py
!**/migrations/*[ -]Conflict*.py

# Local video-frame extraction (audit artefacts; never committed)
.video-frames/

# Local dev artifacts (screenshots, verify dbs)
/tmp/

# Playwright manager auth state (session cookies; regenerated by seed script)
artifacts/manager-playwright-auth.json
# Real-host admin browser sessions contain reusable authenticated cookies and
# are local QA inputs only. JSON evidence reports remain commit-eligible.
artifacts/django-admin-canvas-live/real-host-sessions.local.json

# Full pre-deploy gate raw logs (commit docs/generated/pre_deploy_gate_run_summary.json only)
docs/generated/pre_deploy_gate_run.full.txt
artifacts-evidence/pre_deploy/

# Release hygiene cleanup (batch 1507, 2026-05-25). The artifacts-evidence/ tree
# is the in-tree home for sludge that scanners/verifiers regenerate but should
# not ship in release archives. .gitattributes also export-ignores it.
artifacts-evidence/
var/evidence/click-repro/
var/cand.joblib
var/at_risk_v2_2026q2.joblib
var/at_risk/
var/help-*
var/feedback-*
var/all-hc-*
var/audit-1310-*
var/single-staff-*
var/last-test-*
var/verify-interaction-*
var/test_*.sqlite3*
var/*.sqlite3-shm
var/*.sqlite3-wal
var/lens_test_out.txt
var/lens_tests_result*.txt
var/shard*_nohup.*
var/subagent_nohup.out
var/smoke-results-multi/
var/tenant-abrupt-end-e2e.lock
var/*.partial.json

# Pseudo-locale QA catalog (M21/G3). Machine-generated by
# `manage.py generate_pseudo_locale` from locale/en for i18n QA (hardcoded-string
# + layout-overflow eyeballing); regenerable, never shipped. Ignored so a
# `git add -A` cannot commit it (which would also trip scan_locale_coverage,
# since that gate walks the locale/ dir and demands a declaration per catalog).
locale/en_XA/

# Build stamp written at image build time by scripts/write_build_stamp.py so a
# running box can answer /-/version/. Per-build and per-machine; never committed.
.build-stamp.json

# Cascading OTA. Generated at BUILD time (build.sh / deploy/selfhost/Dockerfile), not
# committed: it is a hash of the tree, so committing it would change on every edit and
# every diff would be 12k lines of noise. `generate_system_manifest --check` is the gate
# that proves a deployment's manifest is current.
system_manifest.json
.rmc_ota_staging/

# Edge box certificate authority material. box-ca-bundle.p12 carries the CA
# PRIVATE KEY; box-ca.crt is public but has no business in the repo either.
# deploy/selfhost/edge-bootstrap.sh writes these OUTSIDE the tree by default --
# this is the second lock, for a box whose RMC_EDGE_OUT_DIR points back at it.
box-ca-bundle.p12
box-ca.crt
