{
  "name": "@runmycampus/webhook-verifier",
  "version": "0.1.0",
  "description": "Verify RunMyCampus Migration Cloud webhook signatures (HMAC-SHA256, canonical JSON). Zero runtime dependencies; works in Node 16+, modern browsers, and Edge runtimes.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "runmycampus",
    "webhook",
    "hmac",
    "signature-verification",
    "canonical-json",
    "education",
    "sis"
  ],
  "author": "RunMyCampus <developers@runmycampus.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/runmycampus/runmycampus.git",
    "directory": "beta/school-management-system/packages/runmycampus-webhook-verifier-js"
  },
  "bugs": {
    "url": "https://github.com/runmycampus/runmycampus/issues"
  },
  "homepage": "https://runmycampus.com",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
