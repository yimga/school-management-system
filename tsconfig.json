{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@analytics/*": ["src/components/shared/analytics/*"],
      "@dashboard/*": ["src/apps/dashboard/*"],
      "@seeds/*": ["src/database/seeds/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/audit-analytics-viz.ts"],
  "exclude": ["node_modules", "companion-extension", "packages"]
}
