{
  "name": "sms-portal",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:marketing": "playwright test tests/e2e/marketing-smoke.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "test:visual:qa": "node node_modules/playwright/cli.js test tests/e2e/ux-visual-qa.spec.js",
    "test:visual:qa:full": "bash scripts/run_visual_qa.sh",
    "ux:assurance": "bash scripts/full_ux_assurance.sh",
    "lint:accessibility": "npx pa11y-ci http://localhost:8000/portal/parent/ http://localhost:8000/teacher/ http://localhost:8000/finance/ || true",
    "check:images": "python scripts/check_image_dimensions.py",
    "perf": "npm run check:images -- && echo 'Lighthouse: run in Chrome DevTools (Lighthouse tab) or npm run lighthouse. See docs/PERFORMANCE_BUDGET.md'",
    "lighthouse": "npx @lhci/cli@0.13.x autorun --config=lighthouserc.js",
    "vendor:dexie": "node -e \"require('fs').mkdirSync('static/js/vendor',{recursive:true})\" && npx copyfiles -f node_modules/dexie/dist/dexie.min.js static/js/vendor/",
    "sweep:abrupt-end:routes": "python scripts/generate_control_plane_sweep_routes.py --write && python scripts/generate_portal_tenant_sweep_routes.py --write",
    "sweep:abrupt-end": "bash scripts/run_platform_abrupt_end_sweep.sh",
    "sweep:abrupt-end:node": "node scripts/verify_platform_abrupt_end_sweep.mjs",
    "perf:playwright": "node scripts/verify_playwright_performance_budgets.mjs",
    "perf:forensic-dom": "node scripts/verify_zero_ticket_dom_budget.mjs",
    "verify:forensic": "python scripts/verify_forensic_master_prompt_completion.py",
    "verify:five-pillar": "python scripts/verify_five_pillar_platform_completion.py --write --run-tests",
    "verify:six-pillar": "python scripts/verify_six_pillar_global_dominance.py --write --run-tests",
    "verify:tenant-sovereignty": "python scripts/verify_tenant_sovereignty_pillar.py --write",
    "verify:manager-chrome": "python scripts/verify_manager_portal_chrome_completion.py --write --run-tests",
    "verify:footer-surface": "python scripts/verify_footer_surface_contract.py --write",
    "verify:marketplace-chromatic": "python scripts/verify_marketplace_proof_surface_dark.py",
    "verify:platform-chromatic": "python scripts/verify_platform_chromatic_compliance.py",
    "build:marketing-css": "python scripts/build_marketing_css_bundles.py",
    "verify:marketing": "python scripts/build_marketing_css_bundles.py && python scripts/generate_marketing_frontend_defect_log.py --write && python scripts/verify_marketing_seo_shell.py && python scripts/verify_marketing_css_bundles_fresh.py && python scripts/verify_marketing_public_shell.py && python scripts/verify_marketing_hero_media.py && python scripts/verify_marketing_impact_layer.py",
    "audit:marketing": "python scripts/audit_marketing_frontend_100.py",
    "audit:marketing:prompt": "python scripts/verify_marketing_redesign_prompt_contract.py --write",
    "verify:marketing:completion": "python scripts/generate_marketing_frontend_defect_log.py --write && python scripts/verify_marketing_seo_shell.py && python scripts/verify_marketing_impact_layer.py && python scripts/verify_marketing_frontend_completion.py",
    "test:e2e:marketing:theme": "playwright test tests/e2e/marketing-theme-contrast.spec.js",
    "test:analytics": "vitest run",
    "test:analytics:watch": "vitest",
    "audit:analytics-viz": "tsx scripts/audit-analytics-viz.ts",
    "build:analytics": "vite build --config vite.analytics.config.ts",
    "verify:analytics": "npm run build:analytics && npm run audit:analytics-viz && npm run test:analytics && python scripts/verify_analytics_viz_prompt_completion.py && python scripts/verify_analytics_viz_gear_up.py",
    "verify:analytics:full": "python scripts/verify_analytics_viz_full_completion.py",
    "seed:analytics": "tsx src/database/seeds/run-analytics-seed.ts",
    "verify:analytics-viz-prompt": "python scripts/verify_analytics_viz_prompt_completion.py",
    "test:social": "vitest run src/components/social",
    "verify:social": "python scripts/verify_social_media_engine.py --write --run-tests"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "copyfiles": "^2.4.1",
    "jsdom": "^24.1.3",
    "pa11y-ci": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
