#!/bin/sh
# RunMyCampus pre-push boundary-gate check.  RMC-PRE-PUSH-HOOK-V1
#
# Installed into <git-dir>/hooks/pre-push by `python scripts/install_git_hooks.py`.
# Mirrors the fast, deps-free CSS/template gates that architectural-boundaries.yml
# runs, so redness is caught locally BEFORE it lands on main (that workflow only
# fires on pull_request, and branch protection isn't available on this plan).
#
# ENFORCING by default since 2026-08-21: a red gate aborts `git push`. It was
# warn-only until then, which was reasonable while something downstream still
# checked -- nothing does. Branch protection is unavailable on this plan, and
# Actions has started no job since 2026-08-15 (runs are created and refused for
# budget, so the workflows go red without executing). This hook is the chain.
#
# To push past a gate you have already understood:  RMC_PREPUSH_STRICT=0 git push
# A gate that TIMED OUT is a resource result, not a finding -- prefer re-running
# it alone, or raise RMC_PREPUSH_GATE_TIMEOUT_S (default 600s), over overriding.
#
# git streams the push refs on stdin; the checker doesn't read them, so redirect
# from /dev/null to guarantee no accidental blocking read.

if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    echo "pre-push: python not found on PATH; skipping boundary gates." >&2
    exit 0
fi

"$PY" scripts/pre_push_boundary_check.py < /dev/null
exit $?
