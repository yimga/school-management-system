# Self-host environment — copy to deploy/selfhost/.env and fill in secrets.
# DATABASE_URL / REDIS_URL / CELERY_BROKER_URL are wired automatically by
# docker-compose.yml (to the db + valkey services) and should NOT be set here.

# --- Secrets (REQUIRED) ---
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_DB=runmycampus
POSTGRES_USER=rmc
POSTGRES_PASSWORD=change-me-strong-password

# --- Hosting / domains ---
# Your server's hostnames. Include the apex + wildcard for tenant subdomains.
ALLOWED_HOSTS=localhost,127.0.0.1,.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com
MULTI_TENANT_BASE_DOMAIN=yourdomain.com
USE_DJANGO_TENANTS=1
DEBUG=0
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_DOMAIN=.yourdomain.com
CSRF_COOKIE_DOMAIN=.yourdomain.com

# --- Gunicorn sizing (tune to your server's cores/RAM) ---
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
# Pin workers explicitly, or leave unset for resource-aware autoscaling.
# GUNICORN_WORKERS=2
DB_MAX_APP_CONNECTIONS=20

# --- Resilience knobs (safe defaults already in code) ---
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=3
CELERY_BROKER_CONNECT_TIMEOUT=2
CELERY_BROKER_SOCKET_TIMEOUT=4
CELERY_WORKER_CONCURRENCY=2

# --- Email (Brevo SMTP or your provider) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Web port published on the host ---
WEB_PORT=10000
