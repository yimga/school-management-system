# Self-hosted RunMyCampus — OFFLINE / LOW-CONNECTIVITY EDGE profile.
# For ONE school on an on-prem mini-PC (e.g. Gilead Tech High, Buea) served over a
# LAN on plain HTTP, with no dependence on the cloud. This is the SOVEREIGN box
# template — the counterpart to .env.example (which targets an internet-connected
# server with a real domain + HTTPS + SMTP).
#
#   cp deploy/selfhost/.env.edge.example deploy/selfhost/.env   # then edit secrets
#   docker compose -f deploy/selfhost/docker-compose.yml up -d --build
#
# FIRST RUN — boot only applies migrations; it does NOT create a school or a login.
# On a fresh (empty) database, create + entitle Gilead in ONE command:
#   docker compose -f deploy/selfhost/docker-compose.yml exec web \
#     python manage.py provision_sovereign_school --create --email owner@school.lan
# That creates the gilead-tech school + a loginable owner via the self-verifying
# create_school engine (it proves the owner can authenticate before returning),
# binds the sovereign plan + every feature, and turns on offline mode. Idempotent —
# safe to re-run. Pass --password to set the owner password (else one is printed).
# ⚠ `seed_render_users` does NOT work on this box: at DEBUG=0 with no seed passwords
# it deliberately creates nothing. Use provision_sovereign_school --create instead.
#
# DATABASE_URL / REDIS_URL / CELERY_BROKER_URL are wired automatically by
# docker-compose.yml (to the db + valkey services) — do NOT set them here.

# --- Secrets (REQUIRED) ---
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_DB=runmycampus
POSTGRES_USER=rmc
POSTGRES_PASSWORD=change-me-strong-password

# --- Single-school / tenancy -------------------------------------------------
# Shared-DB + RLS mode (NOT schema-per-tenant): simplest for one school, and the
# only mode where the bare-hostname fallback below works.
USE_DJANGO_TENANTS=0
# The box serves exactly ONE school. With this on, ANY host that doesn't match a
# subdomain — a bare LAN hostname, the machine's IP, or the base domain — resolves
# to the sole active school, so you do NOT need per-school subdomain DNS.
SINGLE_TENANT=True

# --- Hosting over a LAN on plain HTTP ----------------------------------------
# List the box's LAN hostname(s) and IP. Add the school subdomain too if you set
# up local DNS (e.g. gilead.school.lan), but it is optional in SINGLE_TENANT mode.
ALLOWED_HOSTS=localhost,127.0.0.1,school.lan,gilead.school.lan,10.10.20.137,192.168.1.50
MULTI_TENANT_BASE_DOMAIN=school.lan
# CSRF trusted origins MUST include the scheme (http:// for a plain-HTTP LAN).
CSRF_TRUSTED_ORIGINS=http://school.lan,http://gilead.school.lan,http://10.10.20.137:10000,http://10.10.20.137,http://192.168.1.50
DEBUG=0

# Sovereign edge boxes skip the cloud SaaS activation funnel by default.
CONVERSION_LOCK_STRICT=0

# --- TLS: does this box serve HTTPS, and with whose certificate? -------------
# THE SCHOOL DECIDES. Four modes, and each is a legitimate answer for some school:
#
#   off         Plain HTTP. What Gilead runs today, and honest.
#               COST: the origin is not a SECURE CONTEXT, so browsers withhold
#               crypto.subtle. "Make this device offline ready" asks for a PIN and
#               then fails with "Local access could not be enabled on this browser"
#               — on EVERY browser. That is the origin, not the browser, and no
#               application change can fix it. Offline continuity needs a
#               certificate, full stop.
#
#   selfsigned  The box mints its own. No internet, no domain, no registrar, no
#               cost — the only option that works on a LAN that has never seen the
#               outside world. Install the box CA once per device:
#                 docker compose ... exec web python manage.py edge_tls --issue-selfsigned
#               then copy var/edge-tls/ca.crt to each device. Reissuing the leaf
#               later (new IP, new hostname, expiry) REUSES that CA, so you do not
#               redo the install.
#
#   provided    (alias: ca) Certificate + key issued by a CA the school already
#               trusts — district / ministry internal CA, or a commercial one.
#               Nothing to install on managed devices. Set RMC_EDGE_TLS_CERT and
#               RMC_EDGE_TLS_KEY.
#
#   acme        Automatic issuance from a public CA (Let's Encrypt). Trusted
#               everywhere, self-renewing — but needs a PUBLIC DNS name and inbound
#               reachability for the challenge, which a sovereign box often
#               deliberately does not have. Set RMC_EDGE_TLS_ACME_EMAIL.
#
# TRANSITION IS SUPPORTED IN BOTH DIRECTIONS and is a config change, not a code
# change. `python manage.py edge_tls --plan-to <mode>` prints the ordered steps for
# the mode this box is on right now. See docs/EDGE_TLS_RUNBOOK.md.
RMC_EDGE_TLS_MODE=off
# Names the certificate must assert. Defaults to ALLOWED_HOSTS; set explicitly when
# they differ. IPs are placed in an IPAddress SAN (an IP in a DNS SAN is ignored by
# every browser — the classic reason a hand-rolled LAN certificate still warns).
# RMC_EDGE_TLS_HOSTNAMES=gilead.school.lan,10.10.20.137
# RMC_EDGE_TLS_DIR=/app/var/edge-tls
# mode=provided only — fullchain (leaf first, then intermediates) and private key:
# RMC_EDGE_TLS_CERT=/app/var/edge-tls/fullchain.pem
# RMC_EDGE_TLS_KEY=/app/var/edge-tls/privkey.pem
# mode=acme only:
# RMC_EDGE_TLS_ACME_EMAIL=ops@gilead-tech.example
# RMC_EDGE_TLS_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Ports the TLS terminator publishes (only with `--profile tls`):
# THE ONE FILE YOU CANNOT REGENERATE.
#   A box is a physical object: it moves rooms, campuses, countries, and it gets
#   rebuilt after a failure. The leaf certificate, the Caddyfile, ALLOWED_HOSTS and
#   the origins are all derived and rebuild in a minute. The box CA private key is
#   not. Preserve it and a relocation is a reissue no device notices; lose it and
#   every phone, laptop and tablet that trusted this box must be visited in person.
#
#   Export it BEFORE the box moves or is rebuilt:
#     manage.py edge_tls --export-ca /app/var/edge-tls/box-ca-bundle.p12
#   and restore it on the replacement BEFORE issuing anything:
#     manage.py edge_tls --import-ca /path/box-ca-bundle.p12
#
#   The passphrase is read from the ENVIRONMENT, never a command-line flag: a
#   command line is visible in `ps`, in shell history and in docker's event log.
#   Store the bundle somewhere that is NOT the box, and NOT beside this passphrase --
#   together they let the holder impersonate any site to every device that trusts
#   this box. Leave this unset for day-to-day running; set it only for the export
#   or the restore.
# RMC_EDGE_TLS_CA_PASSPHRASE=
#
# `manage.py edge_tls --plan-relocation --changed address,site,country,hardware`
# prints the ordered steps for the move you are actually making.
#
# SURVIVING AN ADDRESS CHANGE — the box does not hold still.
#   DHCP hands it a new lease, a room is re-cabled onto another subnet, the school
#   moves campus. A certificate names ADDRESSES, so any of those quietly invalidates
#   it for the address people type. Three layers, and only the first is free:
#
#   1. DO NOT DEPEND ON THE IP. Give the box a stable NAME and an address change
#      costs nothing — the certificate still asserts the name. On a LAN with no DNS
#      server, an mDNS `.local` name is answered by the box itself over multicast and
#      follows it to any address on the segment. It needs no server, no records and
#      no per-device configuration, and ALLOWED_HOSTS already accepts `.local` by
#      default. This is the single highest-value line in this file.
#   2. PIN THE LEASE. A DHCP reservation against the box MAC stops the address
#      moving within a site at all. Two minutes in the router.
#   3. SELF-HEAL when it changes anyway. `manage.py edge_tls --ensure` runs on every
#      boot (see deploy/selfhost/entrypoint.web.sh) and does NOTHING unless the
#      certificate is missing, no longer covers an address the box answers at, or is
#      near expiry. When it does act it REUSES the CA on disk, so no device is
#      revisited. It REFUSES to act on an impossible clock rather than minting a
#      genuinely not-yet-valid certificate.
#
# Fold the addresses this box currently holds into ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS
# and the certificate. Off by default: a box with a pinned address and a stable name
# should not silently start asserting whatever DHCP handed it this morning. Turn it ON
# for a box that moves, or one on a network you do not control — otherwise a new lease
# means Django 400s every request until somebody finds this file.
#
# Only the box's OWN addresses are added, read from its routing table — never an
# arbitrary Host header — so the protection ALLOWED_HOSTS exists to give is preserved.
# RMC_EDGE_TRUST_LOCAL_ADDRESSES=0
#
# How many days before expiry --ensure reissues. Generous on purpose: a box switched
# off for a long holiday must still come back to a valid certificate.
# RMC_EDGE_TLS_RENEW_BEFORE_DAYS=30
# EDGE_TLS_HTTPS_PORT=443
# EDGE_TLS_HTTP_PORT=80

# THE LAN-HTTP LOGIN BREAKERS — NOW DERIVED FROM RMC_EDGE_TLS_MODE ABOVE.
# At DEBUG=0 Django defaults these to the secure (HTTPS-only) values, which silently
# break login over plain HTTP (secure cookies never set → the login POST 302s then
# bounces back). You no longer have to know that: setting RMC_EDGE_TLS_MODE sets all
# four correctly, including keeping HSTS at 0 for selfsigned/provided so the choice
# stays REVERSIBLE — HSTS on a LAN name or an IP tells every browser to refuse plain
# HTTP to that origin for a year, and a box that later reverts becomes unreachable
# with no remedy but per-device surgery.
#
# The four lines below are kept ONLY for boxes already running this file. An explicit
# value still wins over the mode, on purpose — but if you set RMC_EDGE_TLS_MODE,
# DELETE them, or you will pin the plain-HTTP posture onto an HTTPS box and spend an
# afternoon on a login that 302s forever. `manage.py edge_tls` prints any
# disagreement, and `check_edge_readiness` FAILs on the dangerous direction.
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
# Only set cookie domains if you use subdomains; leave unset for a bare hostname/IP.
# SESSION_COOKIE_DOMAIN=.school.lan
# CSRF_COOKIE_DOMAIN=.school.lan

# --- AI: local, on-device ----------------------------------------------------
# 'edge' routes AI to a LOCAL Ollama model, then deterministic rules — never the
# cloud. Run Ollama on the host (or add docker-compose.ollama.yml) and pull a
# small model (e.g. `ollama pull llama3.2:3b`). With no model, AI degrades to the
# deterministic 'guided' rules and everything else still works.
RMC_DEPLOYMENT_PROFILE=edge
AI_ALLOW_RULES_FALLBACK=1
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- Email: offline queue-and-forward ----------------------------------------
# With RMC_DEPLOYMENT_PROFILE=edge, outbound mail is PARKED in a durable, encrypted
# queue instead of dropped (the bare console backend reports a false success and
# loses the message). Parked mail forwards automatically when the box is online, via
# the `drain_edge_outbox` cron below. Set an SMTP relay when the box has a reliable
# outbound path; until then the queue holds signups / resets / alerts safely.
#   RMC_EMAIL_OFFLINE_QUEUE defaults ON for the edge profile; force it with =1.
RMC_EMAIL_OFFLINE_QUEUE=1
SCHOOLOPS_EMAIL_DLQ_ENABLED=1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@school.lan
# (The admin-assisted offline password reset still exists so no email is needed to
# recover an account in a low-connectivity area.)

# --- SMS / WhatsApp: queue-and-forward ---------------------------------------
# A send that can't reach its provider (offline / no credentials) is queued durably
# (OutboundMessageQueue) and re-sent by `drain_edge_outbox` when online. Keep this on.
RMC_AUTO_ENQUEUE_OUTBOUND=1

# --- Boot-time readiness gate ------------------------------------------------
# The web container runs `check_edge_readiness` on every boot and prints its
# findings to the logs (silent-dropped mail, the plain-HTTP-over-LAN cookie trap,
# wiped-on-redeploy media, dead drainers, a placeholder SECRET_KEY). Advisory by
# default — it never blocks boot. Set this to 1 to make a FAIL-level finding abort
# startup, so an automated bring-up refuses to serve a misconfigured box.
RMC_EDGE_READINESS_STRICT=0

# --- OCR: local Tesseract (no cloud) -----------------------------------------
# Marksheet / receipt OCR uses Tesseract on-box — never Google Vision. Install the
# system binary (the image build vendors it when RMC_OCR_ENABLED=1) and keep the
# finance receipt method at 'pattern' or 'ocr_tesseract' (a cloud method fails
# offline). Absent Tesseract, OCR simply degrades to manual entry — never a crash.
RMC_OCR_ENABLED=1
# MARKSHEET_OCR_COMMAND=/usr/bin/tesseract   # only if not on PATH

# --- Keys: audit signing + at-rest encryption (offline, no HSM) --------------
# Both are pure-local by default — NO cloud HSM/Vault. Set explicit keys so a
# SECRET_KEY rotation can't strand encrypted data or leave audit events unsigned.
# Leave MIGRATION_CLOUD_AUDIT_SIGNING_BACKEND unset (defaults to local-env-key);
# do NOT set it to aws-kms / azure-keyvault / gcp-kms / hashicorp-vault on this box.
MIGRATION_CLOUD_AUDIT_SIGNING_KEY=change-me-base64-32-bytes-min
DJANGO_CRYPTOGRAPHY_KEY=change-me-fernet-key

# --- Gunicorn sizing (tune to the box; Ryzen 7 7735HS = 8C/16T) --------------
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
DB_MAX_APP_CONNECTIONS=20

# --- Celery: local worker via valkey (all on-box, no internet) ---------------
# The compose runs worker+beat against the local valkey service. Fine on a mini-PC.
# (If you drop the worker/beat services, leave CELERY_BROKER_URL unset and tasks
# run inline/eager — simplest, but long tasks block the request.)
CELERY_WORKER_CONCURRENCY=2
# BROKER-LESS boxes (you dropped the worker/beat services): NOTHING periodic runs, so
# add ONE cron entry that revives the whole in-process registry — the email + SMS/WhatsApp
# drainers, the events outbox (fires internal subscribers), the social cross-post drainer,
# the daily DR snapshot capture, reminders, monitors — each at its own cadence with per-job
# locking:
#   */5 * * * *  python manage.py run_periodic_jobs
# (`drain_edge_outbox` forwards ONLY email + SMS/WhatsApp — a subset that misses the events
#  outbox AND the DR snapshot, so run_periodic_jobs is the COMPLETE beat-less rail. Do NOT
#  run a drainer alongside a Celery worker: two concurrent drainers can double-send. The DR
#  capture NOW rides this cron, but the snapshot lands on THIS box's disk unless you set
#  object storage (AWS_*/MEDIA_STORAGE_BACKEND) — a single mini-PC disk is a single point of
#  failure, so still copy the DB + media + snapshot volumes off-box.)

# --- Edge <-> cloud auto-sync ------------------------------------------------
# Bidirectional sync: the box pushes local changes UP and pulls cloud changes DOWN.
#
# You do NOT need this variable if you PAIR the box (below). A durable pairing --
# written because a named cloud administrator approved THIS box -- counts as the
# switch on its own, which is the point: an installer looking at the pairing screen
# cannot see this file, and a box that paired successfully and then sat idle because
# of a variable nobody mentioned is the exact failure pairing exists to end.
#
# It is still the ONLY switch for a box that was never paired, so it is left set
# here and nothing existing needs migrating.
RMC_EDGE_SYNC_ENABLED=1
# PREFERRED: PAIR the box instead of hand-copying a credential.
#   <box> python manage.py pair_box --slug gilead-tech --wait
# ...or open http://<box-address>:10000/edge/pair-this-box/ on the LAN. The box DISPLAYS a
# short code; a school admin signs in to the cloud Sync Center and approves it. The
# box then collects its own credential over the same outbound path sync uses.
#
# Why pairing is better than the two variables below, not merely easier:
#   * The credential is never displayed, pasted, or written to a file. It is minted
#     during the box's poll and stored in the box's DATABASE, so it survives a
#     container rebuild. A .env lives outside the container and does not.
#   * The cloud address is DERIVED from the slug, so the one value that produces the
#     most confusing failure cannot be mistyped. Under django-tenants the Postgres
#     schema is chosen from the HOSTNAME before auth runs, so a plausible-but-wrong
#     host authenticates fine and then queries the wrong schema.
#   * Pairing uses the same outbound path as sync, so success proves the sync network
#     path works, and failure surfaces BEFORE any credential exists.
#
# A binding written by pairing WINS over the two variables below. To go back to them,
# run `python manage.py pair_box --unpair --yes`.
#
# UNATTENDED INSTALL (nobody with cloud admin reachable while you are on site):
# mint a single-use claim ticket on the cloud BEFORE the visit and redeem it here.
#   <cloud> python manage.py mint_claim_ticket --slug gilead-tech --user admin --days 14
#   <box>   python manage.py pair_box --claim <ticket> --wait
# The ticket pre-authorises exactly ONE adoption of ONE school. It is spent the first
# time it is used, and every later attempt to use it is counted and logged -- the real
# box redeems once and never again, so a second attempt means the ticket is in someone
# else's hands. That alarm is what a long-lived RMC_EDGE_CREDENTIAL can never give you.
#
# The slug is the only value a paired box still needs:
RMC_EDGE_SCHOOL_SLUG=gilead-tech
#
# LEGACY / fallback, still fully supported for boxes that were never paired. Mint the
# credential ON THE CLOUD (operator side): only its sha256 is stored, and it is the
# CLOUD that resolves the raw token on the receiving end, so a credential minted on
# the box is one the cloud has never seen and every push is rejected:
#   <cloud> python manage.py mint_edge_credential --slug gilead-tech --user admin
# The raw token is printed ONCE; copy it to the box as RMC_EDGE_CREDENTIAL below.
# MUST be the TENANT host (django-tenants resolves schema from hostname):
# RMC_EDGE_OPERATOR_BASE=https://gilead-tech.runmycampus.com
# RMC_EDGE_CREDENTIAL=<edge-bearer-token-from-cloud>
# How often it attempts a cycle (seconds; default 180, floor 60). An attempt while
# offline is a cheap no-op, so a tight cadence just means the box reconciles sooner
# after the network returns:
#   RMC_EDGE_SYNC_INTERVAL_SECONDS=180
# WHAT DRIVES IT — no cron needed:
#   * The in-process scheduler runs it off the constantly-pinged /health/ endpoint,
#     so the box auto-syncs simply by being up. After a power loss / reboot / abrupt
#     disconnect it resumes on its own once the network is stable again.
#   * The web entrypoint also fires ONE reconcile on every boot (immediate catch-up).
#   * If you run a Celery worker+beat, the `edge-sync-cycle` beat entry drives the
#     identical task instead.
#   * OPTIONAL near-instant trigger the moment an interface comes up: install
#     deploy/selfhost/edge-sync-on-connect.sh as a NetworkManager dispatcher hook
#     (see the header of that script).
# Manual/on-demand: the tenant Sync Center "Sync now" button, or on the box
#   `python manage.py edge_autosync`  (this box's school; --dry for a no-write probe)
#   `python manage.py edge_sync_cycle --slug gilead-tech`  (explicit slug).

# --- Static files ------------------------------------------------------------
# Hashed static via WhiteNoise (collectstatic runs in the image build).
STATIC_MANIFEST=1

# --- Web port published on the host ------------------------------------------
WEB_PORT=10000

# --- Intentionally UNSET (cloud services that stay dark offline) -------------
# SENTRY_DSN, LITELLM_PROXY_URL, AWS_*/MEDIA_STORAGE_BACKEND: leave unset →
# observability off, AI local, storage on local disk.
# Honest offline behaviour of the external rails:
#   * Email  — PARKED durably + forwarded on reconnect (see RMC_EMAIL_OFFLINE_QUEUE).
#   * SMS/WhatsApp — QUEUED on failure + forwarded on reconnect (RMC_AUTO_ENQUEUE_OUTBOUND).
#   * Card / mobile-money COLLECTION — no offline story; it FAILS CLOSED (nothing is
#     charged or queued) and is deliberately OFF by default. Capture offline payments
#     as OfflinePaymentIntent (cash/manual) and reconcile via the inbound webhook when
#     the box is online. Do NOT set RMC_GATEWAY_COLLECTION_ENABLED on an offline box.
# Run `python manage.py check_edge_readiness --strict` after editing this file.
# Then prove the cloud link end to end, on the box:
#   python manage.py verify_edge_link --http
# It walks deployment -> address -> credential -> school -> scheduler -> reachability
# and names the FIRST broken link with the command that fixes it. Exits non-zero on
# failure, so an automated bring-up can gate on it.

# ── Cascading OTA (over-the-air upgrades) ───────────────────────────────────
# Defaults to "assets": templates, static, locale and data move on their own, because
# they carry no python and no migration, so they need no interpreter reload and cannot
# leave the schema half-applied. Set "full" to also move python + migrations (needs
# RMC_OTA_RELEASE_ROOT below), or "off" to disable entirely.
RMC_OTA_AUTO_APPLY=assets

# Blue-green release layout. UNSET by default: without it the box boots from the image
# tree and a FULL upgrade honestly reports "deferred", because overwriting .py under a
# live interpreter cannot be made atomic. Set this (and mount a volume at the same path)
# to give the box a releases/ + current symlink the rollout manager can flip in one
# rename. Costs one whole-tree copy per release -- budget ~2x the tree on disk.
# RMC_OTA_RELEASE_ROOT=/srv/rmc

# Where gunicorn writes its master pid. The rollout manager HUPs it so an applied upgrade
# is live immediately instead of waiting for a container restart nobody is there to do.
# The entrypoint sets this for you; override only if /tmp is not writable.
# GUNICORN_PIDFILE=/tmp/rmc-gunicorn.pid
