# Self-hosted RunMyCampus — OFFLINE / LOW-CONNECTIVITY EDGE profile.
# For ONE school on an on-prem mini-PC (e.g. Gilead Tech High, Buea) served over a
# LAN on plain HTTP, with no dependence on the cloud. This is the SOVEREIGN box
# template — the counterpart to .env.example (which targets an internet-connected
# server with a real domain + HTTPS + SMTP).
#
#   cp deploy/selfhost/.env.edge.example deploy/selfhost/.env   # then edit secrets
#   docker compose -f deploy/selfhost/docker-compose.yml up -d --build
#
# FIRST RUN — boot only applies migrations; it does NOT create a school or a login.
# On a fresh (empty) database, create + entitle Gilead in ONE command:
#   docker compose -f deploy/selfhost/docker-compose.yml exec web \
#     python manage.py provision_sovereign_school --create --email owner@school.lan
# That creates the gilead-tech school + a loginable owner via the self-verifying
# create_school engine (it proves the owner can authenticate before returning),
# binds the sovereign plan + every feature, and turns on offline mode. Idempotent —
# safe to re-run. Pass --password to set the owner password (else one is printed).
# ⚠ `seed_render_users` does NOT work on this box: at DEBUG=0 with no seed passwords
# it deliberately creates nothing. Use provision_sovereign_school --create instead.
#
# DATABASE_URL / REDIS_URL / CELERY_BROKER_URL are wired automatically by
# docker-compose.yml (to the db + valkey services) — do NOT set them here.

# --- Secrets (REQUIRED) ---
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_DB=runmycampus
POSTGRES_USER=rmc
POSTGRES_PASSWORD=change-me-strong-password

# --- Single-school / tenancy -------------------------------------------------
# Shared-DB + RLS mode (NOT schema-per-tenant): simplest for one school, and the
# only mode where the bare-hostname fallback below works.
USE_DJANGO_TENANTS=0
# The box serves exactly ONE school. With this on, ANY host that doesn't match a
# subdomain — a bare LAN hostname, the machine's IP, or the base domain — resolves
# to the sole active school, so you do NOT need per-school subdomain DNS.
SINGLE_TENANT=True

# --- Hosting over a LAN on plain HTTP ----------------------------------------
# List the box's LAN hostname(s) and IP. Add the school subdomain too if you set
# up local DNS (e.g. gilead.school.lan), but it is optional in SINGLE_TENANT mode.
ALLOWED_HOSTS=localhost,127.0.0.1,school.lan,gilead.school.lan,192.168.1.50
MULTI_TENANT_BASE_DOMAIN=school.lan
# CSRF trusted origins MUST include the scheme (http:// for a plain-HTTP LAN).
CSRF_TRUSTED_ORIGINS=http://school.lan,http://gilead.school.lan,http://192.168.1.50
DEBUG=0

# THE LAN-HTTP LOGIN BREAKERS. At DEBUG=0 these default to the secure (HTTPS-only)
# values, which silently break login over plain HTTP (secure cookies never set →
# the login POST 302s then bounces back). Turn them OFF for a plain-HTTP LAN box.
# If you front the box with a TLS reverse proxy (Caddy/nginx + a local CA), set
# these back to 1 and serve over https instead.
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
# Only set cookie domains if you use subdomains; leave unset for a bare hostname/IP.
# SESSION_COOKIE_DOMAIN=.school.lan
# CSRF_COOKIE_DOMAIN=.school.lan

# --- AI: local, on-device ----------------------------------------------------
# 'edge' routes AI to a LOCAL Ollama model, then deterministic rules — never the
# cloud. Run Ollama on the host (or add docker-compose.ollama.yml) and pull a
# small model (e.g. `ollama pull llama3.2:3b`). With no model, AI degrades to the
# deterministic 'guided' rules and everything else still works.
RMC_DEPLOYMENT_PROFILE=edge
AI_ALLOW_RULES_FALLBACK=1
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- Email: offline queue-and-forward ----------------------------------------
# With RMC_DEPLOYMENT_PROFILE=edge, outbound mail is PARKED in a durable, encrypted
# queue instead of dropped (the bare console backend reports a false success and
# loses the message). Parked mail forwards automatically when the box is online, via
# the `drain_edge_outbox` cron below. Set an SMTP relay when the box has a reliable
# outbound path; until then the queue holds signups / resets / alerts safely.
#   RMC_EMAIL_OFFLINE_QUEUE defaults ON for the edge profile; force it with =1.
RMC_EMAIL_OFFLINE_QUEUE=1
SCHOOLOPS_EMAIL_DLQ_ENABLED=1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@school.lan
# (The admin-assisted offline password reset still exists so no email is needed to
# recover an account in a low-connectivity area.)

# --- SMS / WhatsApp: queue-and-forward ---------------------------------------
# A send that can't reach its provider (offline / no credentials) is queued durably
# (OutboundMessageQueue) and re-sent by `drain_edge_outbox` when online. Keep this on.
RMC_AUTO_ENQUEUE_OUTBOUND=1

# --- OCR: local Tesseract (no cloud) -----------------------------------------
# Marksheet / receipt OCR uses Tesseract on-box — never Google Vision. Install the
# system binary (the image build vendors it when RMC_OCR_ENABLED=1) and keep the
# finance receipt method at 'pattern' or 'ocr_tesseract' (a cloud method fails
# offline). Absent Tesseract, OCR simply degrades to manual entry — never a crash.
RMC_OCR_ENABLED=1
# MARKSHEET_OCR_COMMAND=/usr/bin/tesseract   # only if not on PATH

# --- Keys: audit signing + at-rest encryption (offline, no HSM) --------------
# Both are pure-local by default — NO cloud HSM/Vault. Set explicit keys so a
# SECRET_KEY rotation can't strand encrypted data or leave audit events unsigned.
# Leave MIGRATION_CLOUD_AUDIT_SIGNING_BACKEND unset (defaults to local-env-key);
# do NOT set it to aws-kms / azure-keyvault / gcp-kms / hashicorp-vault on this box.
MIGRATION_CLOUD_AUDIT_SIGNING_KEY=change-me-base64-32-bytes-min
DJANGO_CRYPTOGRAPHY_KEY=change-me-fernet-key

# --- Gunicorn sizing (tune to the box; Ryzen 7 7735HS = 8C/16T) --------------
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
DB_MAX_APP_CONNECTIONS=20

# --- Celery: local worker via valkey (all on-box, no internet) ---------------
# The compose runs worker+beat against the local valkey service. Fine on a mini-PC.
# (If you drop the worker/beat services, leave CELERY_BROKER_URL unset and tasks
# run inline/eager — simplest, but long tasks block the request.)
CELERY_WORKER_CONCURRENCY=2
# BROKER-LESS boxes (you dropped the worker/beat services): NOTHING periodic runs, so
# add ONE cron entry that revives the whole in-process registry — the email + SMS/WhatsApp
# drainers, the events outbox (fires internal subscribers), the social cross-post drainer,
# the daily DR snapshot capture, reminders, monitors — each at its own cadence with per-job
# locking:
#   */5 * * * *  python manage.py run_periodic_jobs
# (`drain_edge_outbox` forwards ONLY email + SMS/WhatsApp — a subset that misses the events
#  outbox AND the DR snapshot, so run_periodic_jobs is the COMPLETE beat-less rail. Do NOT
#  run a drainer alongside a Celery worker: two concurrent drainers can double-send. The DR
#  capture NOW rides this cron, but the snapshot lands on THIS box's disk unless you set
#  object storage (AWS_*/MEDIA_STORAGE_BACKEND) — a single mini-PC disk is a single point of
#  failure, so still copy the DB + media + snapshot volumes off-box.)

# --- Static files ------------------------------------------------------------
# Hashed static via WhiteNoise (collectstatic runs in the image build).
STATIC_MANIFEST=1

# --- Web port published on the host ------------------------------------------
WEB_PORT=10000

# --- Intentionally UNSET (cloud services that stay dark offline) -------------
# SENTRY_DSN, LITELLM_PROXY_URL, AWS_*/MEDIA_STORAGE_BACKEND: leave unset →
# observability off, AI local, storage on local disk.
# Honest offline behaviour of the external rails:
#   * Email  — PARKED durably + forwarded on reconnect (see RMC_EMAIL_OFFLINE_QUEUE).
#   * SMS/WhatsApp — QUEUED on failure + forwarded on reconnect (RMC_AUTO_ENQUEUE_OUTBOUND).
#   * Card / mobile-money COLLECTION — no offline story; it FAILS CLOSED (nothing is
#     charged or queued) and is deliberately OFF by default. Capture offline payments
#     as OfflinePaymentIntent (cash/manual) and reconcile via the inbound webhook when
#     the box is online. Do NOT set RMC_GATEWAY_COLLECTION_ENABLED on an offline box.
# Run `python manage.py check_edge_readiness --strict` after editing this file.
