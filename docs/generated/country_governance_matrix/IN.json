      "te": "\u0c24\u0c4d\u0c30\u0c48\u0c2e\u0c3e\u0c38\u0c3f\u0c15\u0c2e\u0c41 (Traim\u0101sikamu)",
      "mr": "\u0938\u0924\u094d\u0930 (Satra)",
