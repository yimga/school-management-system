  "local_terminology": {
    "teacher": {
      "en": "Teacher / Shikshak / \u0936\u093f\u0915\u094d\u0937\u0915",
      "hi": "Adhy\u0101pak",
      "ta": "\u0b86\u0b9a\u0bbf\u0bb0\u0bbf\u0baf\u0bb0\u0bcd (Aasiriyar)",
      "te": "\u0c09\u0c2a\u0c3e\u0c27\u0c4d\u0c2f\u0c3e\u0c2f\u0c41\u0c21\u0c41 (Up\u0101dhy\u0101yudu)",
      "mr": "\u0936\u093f\u0915\u094d\u0937\u0915 (Shikshak)",
      "bn": "\u09b6\u09bf\u0995\u09cd\u09b7\u0995 (Shikkhok)",
      "gu": "\u0ab6\u0abf\u0a95\u0acd\u0ab7\u0a95 (Shikshak)",
      "ml": "\u0d05\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d3e\u0d2a\u0d15\u0d7b (Adhy\u0101pakan)",
      "kn": "\u0cb6\u0cbf\u0c95\u0ccd\u0cb7\u0c95\u0cb0\u0cc1 (Shikshakaru)",
      "pa": "\u0a05\u0a27\u0a3f\u0a06\u0a2a\u0a15 (Adhy\u0101pak)",
      "or": "\u0b36\u0b3f\u0b15\u0b4d\u0b37\u0b15 (Shikshyaka)",
      "as": "\u09b6\u09bf\u0995\u09cd\u09b7\u0995 (Xikkhok)",
      "ur": "\u0627\u0633\u062a\u0627\u0630 / \u0645\u064f\u0639\u064e\u0644\u0651\u0645 (Ust\u0101d / Mu\u02bfallim)"
    },
    "principal": {
      "en": "Principal / Prach\u0101rya",
      "hi": "Pradh\u0101n\u0101ch\u0101rya",
      "ta": "\u0ba4\u0bb2\u0bc8\u0bae\u0bc8 \u0b86\u0b9a\u0bbf\u0bb0\u0bbf\u0baf\u0bb0\u0bcd (Thalaimai Aasiriyar)",
      "te": "\u0c2a\u0c4d\u0c30\u0c27\u0c3e\u0c28\u0c4b\u0c2a\u0c3e\u0c27\u0c4d\u0c2f\u0c3e\u0c2f\u0c41\u0c21\u0c41 (Pradh\u0101n\u014dp\u0101dhy\u0101yudu)",
      "mr": "\u092e\u0941\u0916\u094d\u092f\u093e\u0927\u094d\u092f\u093e\u092a\u0915 (Mukhyadhyapak)",
      "bn": "\u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09b6\u09bf\u0995\u09cd\u09b7\u0995 (Prodhan Shikkhok)",
      "gu": "\u0a86\u0a9a\u0abe\u0ab0\u0acd\u0aaf (Acharya)",
      "ml": "\u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d05\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d3e\u0d2a\u0d15\u0d7b (Pradh\u0101na Adhy\u0101pakan)",
      "kn": "\u0cae\u0cc1\u0c96\u0ccd\u0caf\u0ccb\u0caa\u0cbe\u0ca7\u0ccd\u0caf\u0cbe\u0caf\u0cb0\u0cc1 (Mukhyopadhyayaru)",
      "pa": "\u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a38\u0a40\u0a2a\u0a32 (Princhipal)",
      "or": "\u0b2a\u0b4d\u0b30\u0b27\u0b3e\u0b28 \u0b36\u0b3f\u0b15\u0b4d\u0b37\u0b15 (Pradh\u0101na Shikshyaka)",
      "as": "\u09aa\u09cd\u09f0\u09a7\u09be\u09a8 \u09b6\u09bf\u0995\u09cd\u09b7\u0995 (Prodhan Xikkhok)",
      "ur": "\u0645\u064f\u062f\u06cc\u0631 (Mud\u012br)"
    },
    "term": {
