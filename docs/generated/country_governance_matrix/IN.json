    },
    "report_card": {
      "en": "Report Card",
      "hi": "Prativedan",
      "ta": "\u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bc7\u0bb1\u0bcd\u0bb1 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc8 (Munnetra Arikai)",
      "te": "\u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15 (Niv\u0113dika)",
      "mr": "\u092a\u094d\u0930\u0917\u0924\u0940 \u092a\u0941\u0938\u094d\u0924\u0915 (Pragati Pustak)",
      "bn": "\u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09c7\u09a6\u09a8 (Protibedon)",
      "gu": "\u0aaa\u0acd\u0ab0\u0a97\u0aa4\u0abf \u0aaa\u0aa4\u0acd\u0ab0\u0a95 (Pragati Patrak)",
      "ml": "\u0d2a\u0d41\u0d30\u0d4b\u0d17\u0d24\u0d3f \u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d (Pur\u014dgati Ripp\u014dr\u1e6d\u1e6d)",
      "kn": "\u0caa\u0ccd\u0cb0\u0c97\u0ca4\u0cbf \u0cb5\u0cb0\u0ca6\u0cbf (Pragati Varadi)",
      "pa": "\u0a2a\u0a4d\u0a30\u0a17\u0a24\u0a40 \u0a30\u0a3f\u0a2a\u0a4b\u0a30\u0a1f (Pragati Ripor\u1e6d)",
      "or": "\u0b2a\u0b4d\u0b30\u0b17\u0b24\u0b3f \u0b2a\u0b24\u0b4d\u0b30 (Pragati Patra)",
      "as": "\u09aa\u09cd\u09f0\u0997\u09a4\u09bf \u09aa\u09a4\u09cd\u09f0 (Progoti Potro)",
      "ur": "\u0631\u067e\u0648\u0631\u0679 \u06a9\u0627\u0631\u0688 (Ripor\u1e6d K\u0101r\u1e0d)"
