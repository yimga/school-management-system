{
  "wizard_key": "parent_link_child",
  "version": 1,
  "audience": ["parent"],
  "label_token": "wizards.parent_link_child.label",
  "description_token": "wizards.parent_link_child.description",
  "icon_class": "rmc-icon-link",
  "estimated_minutes": 3,
  "gates": {},
  "ai": {},
  "steps": [
    {
      "key": "identify_child",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "admission_number",
          "type": "text",
          "required": true,
          "validation": {"max_length": 64}
        },
        {
          "name": "relationship",
          "type": "select",
          "required": true,
          "choices_resolver": "apps.setup_studio.wizard_resolvers_operator::list_relationship_choices"
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_parent_link_child_step"
      },
      "estimated_seconds": 90
    },
    {
      "key": "contact_preferences",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "preferred_contact",
          "type": "select",
          "required": true
        },
        {
          "name": "quiet_hours_ok",
          "type": "boolean",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_parent_link_child_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "confirm_link",
      "input_type": "boolean",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_parent_link_child_step"
      },
      "estimated_seconds": 30
    }
  ]
}
