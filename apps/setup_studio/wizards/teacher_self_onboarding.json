{
  "wizard_key": "teacher_self_onboarding",
  "version": 1,
  "audience": ["teacher"],
  "label_token": "wizards.teacher_self_onboarding.label",
  "description_token": "wizards.teacher_self_onboarding.description",
  "icon_class": "rmc-icon-person-plus",
  "estimated_minutes": 5,
  "gates": {},
  "ai": {},
  "steps": [
    {
      "key": "basic_information",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "first_name",
          "type": "text",
          "required": true,
          "validation": {"max_length": 100}
        },
        {
          "name": "last_name",
          "type": "text",
          "required": true,
          "validation": {"max_length": 100}
        },
        {
          "name": "email",
          "type": "text",
          "required": true,
          "validation": {"email_shape": true, "max_length": 254}
        },
        {
          "name": "phone",
          "type": "text",
          "required": false,
          "validation": {"max_length": 32, "pattern": "^[+0-9 ()-]{6,32}$"}
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_teacher_self_onboarding_step"
      },
      "estimated_seconds": 90
    },
    {
      "key": "professional_details",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "staff_id",
          "type": "text",
          "required": false,
          "validation": {"max_length": 64}
        },
        {
          "name": "position_title",
          "type": "text",
          "required": false,
          "validation": {"max_length": 120}
        },
        {
          "name": "department",
          "type": "text",
          "required": false,
          "validation": {"max_length": 120}
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_teacher_self_onboarding_step"
      },
      "estimated_seconds": 75
    },
    {
      "key": "preferences",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "payment_method",
          "type": "select",
          "required": false
        },
        {
          "name": "default_dashboard_view",
          "type": "select",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_teacher_self_onboarding_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "profile_photo",
      "input_type": "image_upload",
      "validation": {
        "required": false,
        "allowed_extensions": ["jpg", "jpeg", "png", "webp"],
        "max_file_bytes": 8388608
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_teacher_self_onboarding_step"
      },
      "estimated_seconds": 60
    }
  ]
}
