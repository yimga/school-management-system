{
  "wizard_key": "teacher_attendance_intake",
  "version": 1,
  "audience": ["teacher"],
  "label_token": "wizards.teacher_attendance_intake.label",
  "description_token": "wizards.teacher_attendance_intake.description",
  "icon_class": "rmc-icon-clipboard-check",
  "estimated_minutes": 3,
  "gates": {},
  "ai": {},
  "steps": [
    {
      "key": "select_class",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_domain::list_teacher_classes",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_teacher_attendance_intake_step"
      },
      "estimated_seconds": 30
    },
    {
      "key": "session_window",
      "input_type": "structured_form",
      "fields": [
        {"name": "start_time", "type": "text", "required": true},
        {"name": "end_time", "type": "text", "required": true},
        {"name": "grace_minutes", "type": "number", "required": false}
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_teacher_attendance_intake_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "default_statuses",
      "input_type": "multi_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_domain::list_attendance_status_choices",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_teacher_attendance_intake_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "auto_notify",
      "input_type": "boolean",
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_teacher_attendance_intake_step"
      },
      "estimated_seconds": 30
    }
  ]
}
