{
  "wizard_key": "super_create_school",
  "version": 1,
  "audience": ["operator"],
  "label_token": "wizards.super_create_school.label",
  "description_token": "wizards.super_create_school.description",
  "icon_class": "rmc-icon-building",
  "estimated_minutes": 8,
  "gates": {
    "platform_scope": "PLATFORM_SCOPE_PROVISION"
  },
  "ai": {},
  "steps": [
    {
      "key": "identity",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "school_name",
          "type": "text",
          "required": true,
          "validation": {"max_length": 200}
        },
        {
          "name": "school_code",
          "type": "text",
          "required": true,
          "validation": {"max_length": 40, "pattern": "^[A-Z0-9_-]+$"}
        },
        {
          "name": "school_slug",
          "type": "text",
          "required": true,
          "validation": {"max_length": 60, "pattern": "^[a-z0-9-]+$"}
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_super_create_school_step"
      },
      "estimated_seconds": 90
    },
    {
      "key": "region",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_operator::list_country_choices_for_wizard",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_super_create_school_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "education_template",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_operator::list_education_template_choices",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_super_create_school_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "branding",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "primary_color",
          "type": "color",
          "required": false,
          "validation": {"color_hex": true}
        },
        {
          "name": "logo_url",
          "type": "text",
          "required": false,
          "validation": {"max_length": 256}
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_super_create_school_step"
      },
      "estimated_seconds": 90
    },
    {
      "key": "review_and_provision",
      "input_type": "boolean",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_super_create_school_step"
      },
      "estimated_seconds": 120
    }
  ]
}
