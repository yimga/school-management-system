{
  "wizard_key": "exam_schedule_orchestration",
  "version": 1,
  "audience": ["tenant_admin"],
  "label_token": "wizards.exam_schedule_orchestration.label",
  "description_token": "wizards.exam_schedule_orchestration.description",
  "icon_class": "rmc-icon-calendar-check",
  "estimated_minutes": 12,
  "ai": {"smart_defaults": true, "branch_rationale": true},
  "steps": [
    {
      "key": "exam_window_anchor",
      "input_type": "structured_form",
      "fields": [
        {"name": "exam_window_label", "type": "text", "required": true, "validation": {"max_length": 80}},
        {"name": "window_start_date", "type": "date", "required": true},
        {"name": "window_end_date", "type": "date", "required": true},
        {"name": "results_publish_date", "type": "date", "required": true}
      ],
      "persistence": {"target": "site_settings", "writer": "apps.setup_studio.wizard_resolvers::write_exam_window"}
    },
    {
      "key": "room_allocation_strategy",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers::list_exam_room_strategies",
      "validation": {"required": true},
      "persistence": {"target": "site_settings", "writer": "apps.setup_studio.wizard_resolvers::write_exam_room_strategy"}
    },
    {
      "key": "invigilator_assignment",
      "input_type": "structured_form",
      "fields": [
        {"name": "invigilator_count_per_room", "type": "number", "required": true, "validation": {"integer_min": 1, "integer_max": 10}},
        {"name": "max_invigilation_hours_per_teacher_per_day", "type": "number", "required": true, "validation": {"integer_min": 1, "integer_max": 24}},
        {"name": "subject_teacher_exempt", "type": "boolean", "required": true},
        {"name": "auto_balance_load", "type": "boolean", "required": true}
      ],
      "persistence": {"target": "site_settings", "writer": "apps.setup_studio.wizard_resolvers::write_exam_invigilator"}
    },
    {
      "key": "results_publication_pipeline",
      "input_type": "structured_form",
      "fields": [
        {"name": "auto_release_to_parents", "type": "boolean", "required": true},
        {"name": "require_admin_approval_before_release", "type": "boolean", "required": true},
        {"name": "include_class_rank", "type": "boolean", "required": true},
        {"name": "include_subject_teacher_comment", "type": "boolean", "required": true}
      ],
      "persistence": {"target": "site_settings", "writer": "apps.setup_studio.wizard_resolvers::write_exam_results_pipeline"}
    }
  ]
}
