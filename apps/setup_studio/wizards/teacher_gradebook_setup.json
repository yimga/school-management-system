{
  "wizard_key": "teacher_gradebook_setup",
  "version": 1,
  "audience": ["teacher"],
  "label_token": "wizards.teacher_gradebook_setup.label",
  "description_token": "wizards.teacher_gradebook_setup.description",
  "icon_class": "rmc-icon-grid",
  "estimated_minutes": 5,
  "gates": {},
  "ai": {},
  "steps": [
    {
      "key": "select_class",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_domain::list_teacher_classes",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_teacher_gradebook_setup_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "grading_scale",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_domain::list_grading_scale_choices",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_teacher_gradebook_setup_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "weights",
      "input_type": "key_value_pairs",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_teacher_gradebook_setup_step"
      },
      "estimated_seconds": 120
    },
    {
      "key": "policies",
      "input_type": "structured_form",
      "fields": [
        {"name": "drop_lowest_count", "type": "number", "required": false},
        {"name": "late_penalty_percent", "type": "number", "required": false},
        {"name": "round_to_nearest", "type": "select", "required": false}
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_teacher_gradebook_setup_step"
      },
      "estimated_seconds": 75
    }
  ]
}
