{
  "wizard_key": "student_password_rotation",
  "version": 1,
  "audience": ["student", "staff", "teacher", "parent"],
  "label_token": "wizards.student_password_rotation.label",
  "description_token": "wizards.student_password_rotation.description",
  "icon_class": "rmc-icon-key",
  "estimated_minutes": 2,
  "gates": {},
  "ai": {},
  "steps": [
    {
      "key": "verify_identity",
      "input_type": "text",
      "validation": {"required": true, "min_length": 1, "max_length": 254},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_password_rotation_step"
      },
      "estimated_seconds": 30
    },
    {
      "key": "new_password",
      "input_type": "structured_form",
      "fields": [
        {"name": "new_password",     "type": "text", "required": true, "validation": {"min_length": 12, "max_length": 128}},
        {"name": "confirm_password", "type": "text", "required": true, "validation": {"min_length": 12, "max_length": 128}}
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_password_rotation_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "confirm",
      "input_type": "boolean",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_password_rotation_step"
      },
      "estimated_seconds": 30
    }
  ]
}
