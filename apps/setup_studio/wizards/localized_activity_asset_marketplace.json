{
  "wizard_key": "localized_activity_asset_marketplace",
  "version": 1,
  "audience": [
    "operator",
    "tenant_admin"
  ],
  "label_token": "wizards.localized_activity_asset_marketplace.label",
  "description_token": "wizards.localized_activity_asset_marketplace.description",
  "icon_class": "rmc-icon-store",
  "estimated_minutes": 12,
  "gates": {
    "permission_codename": "marketplace.change_storefront",
    "prerequisite_wizard": "local_first_fintech_tax_matrix"
  },
  "ai": {
    "smart_defaults": true
  },
  "steps": [
    {
      "key": "storefront_blueprinting",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "storefront_name",
          "type": "text",
          "required": true,
          "validation": {
            "max_length": 80
          }
        },
        {
          "name": "default_currency",
          "type": "select",
          "required": true,
          "choices_resolver": "apps.setup_studio.wizard_resolvers::list_settlement_currencies",
          "validation": {
            "iso_currency": true
          }
        },
        {
          "name": "default_tax_inclusive",
          "type": "boolean",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_marketplace_storefront"
      }
    },
    {
      "key": "product_catalog_seed",
      "input_type": "file_upload",
      "validation": {
        "allowed_extensions": [
          "csv",
          "xlsx"
        ],
        "max_file_bytes": 5242880
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_marketplace_catalog"
      }
    },
    {
      "key": "financial_routing",
      "input_type": "single_choice",
      "validation": {
        "required": true
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_marketplace_routing"
      }
    },
    {
      "key": "ticket_receipt_automation",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "receipt_template",
          "type": "text",
          "required": true
        },
        {
          "name": "delivery_channel",
          "type": "select",
          "required": true,
          "choices_resolver": "apps.setup_studio.wizard_resolvers::list_communication_channels"
        },
        {
          "name": "include_qr_code",
          "type": "boolean",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_marketplace_receipts"
      }
    }
  ]
}
