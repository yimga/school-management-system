{
  "wizard_key": "staff_onboarding",
  "version": 1,
  "audience": [
    "staff"
  ],
  "label_token": "wizards.staff_onboarding.label",
  "description_token": "wizards.staff_onboarding.description",
  "icon_class": "rmc-icon-badge",
  "estimated_minutes": 6,
  "gates": {},
  "ai": {},
  "steps": [
    {
      "key": "profile_basics",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "full_name",
          "type": "text",
          "required": true,
          "validation": {
            "max_length": 200
          }
        },
        {
          "name": "employee_id",
          "type": "text",
          "required": false,
          "validation": {
            "max_length": 64
          }
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_staff_profile"
      }
    },
    {
      "key": "role_assignment",
      "input_type": "single_choice",
      "validation": {
        "required": true
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_staff_role"
      }
    },
    {
      "key": "background_check_status",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "has_background_check",
          "type": "boolean",
          "required": true
        },
        {
          "name": "background_check_file",
          "type": "file",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_staff_background"
      }
    },
    {
      "key": "schedule_preferences",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "standard_hours_per_week",
          "type": "number",
          "required": true
        },
        {
          "name": "preferred_break_minutes",
          "type": "number",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_staff_schedule"
      }
    },
    {
      "key": "training_module_assignment",
      "input_type": "multi_choice",
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_staff_training"
      }
    }
  ]
}
