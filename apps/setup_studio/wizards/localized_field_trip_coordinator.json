{
  "wizard_key": "localized_field_trip_coordinator",
  "version": 1,
  "audience": [
    "teacher"
  ],
  "label_token": "wizards.localized_field_trip_coordinator.label",
  "description_token": "wizards.localized_field_trip_coordinator.description",
  "icon_class": "rmc-icon-bus",
  "estimated_minutes": 6,
  "gates": {
    "permission_codename": "school_events.add_fieldtrip"
  },
  "ai": {
    "smart_defaults": true
  },
  "steps": [
    {
      "key": "logistics_definition",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "trip_name",
          "type": "text",
          "required": true
        },
        {
          "name": "destination",
          "type": "text",
          "required": true
        },
        {
          "name": "departure_datetime",
          "type": "text",
          "required": true
        },
        {
          "name": "return_datetime",
          "type": "text",
          "required": true
        },
        {
          "name": "transport_type",
          "type": "select",
          "required": true,
          "choices_resolver": "apps.setup_studio.wizard_resolvers::list_field_trip_transport"
        },
        {
          "name": "cost_per_student_decimal",
          "type": "decimal",
          "required": false
        }
      ],
      "ai_recommend": {
        "enabled": true,
        "context_keys": [
          "country_code"
        ],
        "prompt_template_key": "prompt.fieldtrip.suggest_costs"
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_fieldtrip_logistics"
      }
    },
    {
      "key": "automated_authorization_pipeline",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "parent_signature_required",
          "type": "boolean",
          "required": false
        },
        {
          "name": "payment_required",
          "type": "boolean",
          "required": false
        },
        {
          "name": "medical_release_required",
          "type": "boolean",
          "required": false
        },
        {
          "name": "photo_consent_required",
          "type": "boolean",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_fieldtrip_authorization"
      }
    },
    {
      "key": "real_time_roster_ledger",
      "input_type": "boolean",
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_fieldtrip_roster"
      }
    }
  ]
}
