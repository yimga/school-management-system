{
  "wizard_key": "jit_operator_compliance_safeguarding",
  "version": 1,
  "audience": [
    "operator"
  ],
  "label_token": "wizards.jit_operator_compliance_safeguarding.label",
  "description_token": "wizards.jit_operator_compliance_safeguarding.description",
  "icon_class": "rmc-icon-lock",
  "estimated_minutes": 8,
  "gates": {
    "permission_codename": "security.change_jit_policy"
  },
  "ai": {
    "branch_rationale": true
  },
  "steps": [
    {
      "key": "assumed_access_trigger",
      "input_type": "multi_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers::list_jit_triggers",
      "ai_recommend": {
        "enabled": true,
        "context_keys": [
          "country_code"
        ],
        "prompt_template_key": "prompt.compliance.suggest_access_trigger"
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_compliance_triggers"
      }
    },
    {
      "key": "external_guardrail_selection",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "geo_fence_radius_meters",
          "type": "number",
          "required": false
        },
        {
          "name": "allowed_ip_ranges",
          "type": "textarea",
          "required": false
        },
        {
          "name": "require_2fa_within_window",
          "type": "boolean",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_compliance_guardrails"
      }
    },
    {
      "key": "identity_masking_form",
      "input_type": "multi_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers::list_pii_redaction_fields",
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_compliance_masking"
      }
    },
    {
      "key": "ledger_immutable_endpoint",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers::list_audit_anchors",
      "validation": {
        "required": true
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_compliance_ledger"
      }
    }
  ]
}
