{
  "wizard_key": "edge_location_onboarding",
  "version": 1,
  "audience": ["operator", "tenant_admin"],
  "label_token": "wizards.edge_location_onboarding.label",
  "description_token": "wizards.edge_location_onboarding.description",
  "icon_class": "rmc-icon-globe",
  "estimated_minutes": 8,
  "gates": {},
  "ai": {},
  "steps": [
    {
      "key": "site_and_addresses",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "site_name",
          "type": "text",
          "required": true,
          "validation": {"max_length": 120}
        },
        {
          "name": "addresses",
          "type": "text",
          "required": true,
          "validation": {"max_length": 512}
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_edge_location_onboarding_step"
      },
      "estimated_seconds": 165
    },
    {
      "key": "tls_choice",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_operator::list_edge_tls_mode_choices",
      "validation": {"required": true},
      "branches": {
        "selfsigned": "device_trust",
        "provided": "certificate_source",
        "acme": "acme_contact",
        "off": "plain_http_confirm",
        "default": "plain_http_confirm"
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_edge_location_onboarding_step"
      },
      "estimated_seconds": 180
    },
    {
      "key": "device_trust",
      "input_type": "boolean",
      "validation": {"required": true},
      "branches": {"default": "mobility"},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_edge_location_onboarding_step"
      },
      "estimated_seconds": 90
    },
    {
      "key": "certificate_source",
      "input_type": "text",
      "validation": {"required": true, "max_length": 200},
      "branches": {"default": "mobility"},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_edge_location_onboarding_step"
      },
      "estimated_seconds": 90
    },
    {
      "key": "acme_contact",
      "input_type": "text",
      "validation": {"required": true, "max_length": 254},
      "branches": {"default": "mobility"},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_edge_location_onboarding_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "plain_http_confirm",
      "input_type": "boolean",
      "validation": {"required": true},
      "branches": {"default": "mobility"},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_edge_location_onboarding_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "mobility",
      "input_type": "single_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_operator::list_edge_mobility_choices",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_edge_location_onboarding_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "review",
      "input_type": "boolean",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_operator::write_edge_location_onboarding_step"
      },
      "estimated_seconds": 120
    }
  ]
}
