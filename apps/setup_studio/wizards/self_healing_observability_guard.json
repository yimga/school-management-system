{
  "wizard_key": "self_healing_observability_guard",
  "version": 1,
  "audience": [
    "operator"
  ],
  "label_token": "wizards.self_healing_observability_guard.label",
  "description_token": "wizards.self_healing_observability_guard.description",
  "icon_class": "rmc-icon-heartbeat",
  "estimated_minutes": 8,
  "gates": {
    "permission_codename": "observability.change_threshold"
  },
  "ai": {
    "smart_defaults": true
  },
  "steps": [
    {
      "key": "threshold_definition",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "error_rate_threshold_pct",
          "type": "decimal",
          "required": true
        },
        {
          "name": "latency_p95_threshold_ms",
          "type": "number",
          "required": true
        },
        {
          "name": "uptime_target_pct",
          "type": "decimal",
          "required": true
        }
      ],
      "ai_recommend": {
        "enabled": true,
        "context_keys": [
          "school_size_band"
        ],
        "prompt_template_key": "prompt.observability.suggest_thresholds"
      },
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_observability_thresholds"
      }
    },
    {
      "key": "recovery_actions",
      "input_type": "multi_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers::list_observability_recovery_actions",
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_observability_actions"
      }
    },
    {
      "key": "support_tunnel_activation",
      "input_type": "structured_form",
      "fields": [
        {
          "name": "max_session_duration_minutes",
          "type": "number",
          "required": false
        },
        {
          "name": "require_screen_recording",
          "type": "boolean",
          "required": false
        },
        {
          "name": "notify_tenant_admin_on_open",
          "type": "boolean",
          "required": false
        }
      ],
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers::write_observability_tunnel"
      }
    }
  ]
}
