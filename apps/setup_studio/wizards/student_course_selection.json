      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_student_course_selection_step"
      },
      "estimated_seconds": 90
    },
    {
      "key": "confirm",
      "input_type": "boolean",
      "validation": {"required": true},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_student_course_selection_step"
      },
      "estimated_seconds": 30
    }
  ]
