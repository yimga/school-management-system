      },
      "estimated_seconds": 30
    },
    {
      "key": "required_courses",
      "input_type": "multi_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_domain::list_required_course_choices",
      "validation": {"required": false},
      "persistence": {
        "target": "custom",
        "writer": "apps.setup_studio.wizard_resolvers_domain::write_student_course_selection_step"
      },
      "estimated_seconds": 60
    },
    {
      "key": "electives",
      "input_type": "multi_choice",
      "options_resolver": "apps.setup_studio.wizard_resolvers_domain::list_elective_course_choices",
