{
  "manifest_version": 3,
  "name": "RunMyCampus Companion",
  "version": "1.0.0",
  "description": "Operator-authorized helper that reads roster data from the SIS tab you're already logged into and uploads it (sealed-box encrypted) to RunMyCampus migration cloud.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.powerschool.com/*",
    "https://*.blackbaud.com/*",
    "https://*.veracross.com/*",
    "https://*.getalma.com/*",
    "https://*.factsmgt.com/*",
    "https://*.skyward.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RunMyCampus Companion"
  },
  "background": {
    "service_worker": "src/background/service_worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.powerschool.com/*",
        "https://*.blackbaud.com/*",
        "https://*.veracross.com/*",
        "https://*.getalma.com/*",
        "https://*.factsmgt.com/*",
        "https://*.skyward.com/*"
      ],
      "js": ["src/content/content_script.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
